def layout_batches(layout, limit=1200):
    """Split a layout into pieces small enough for one admin packet, keeping build order:
    stations (all in the first batch), then all tracks, then all bridges, then all signals."""
    def size(l):
        return len(json.dumps(l, separators=(",", ":")))
    out = []
    if layout.get("stations"):
        out.append({"size": layout.get("size"), "stations": layout["stations"]})
    for key in ("tracks", "bridges", "signals"):
        cur = []
        for item in layout.get(key, []):
            if cur and size({key: cur + [item]}) > limit:
                out.append({"size": layout.get("size"), key: cur})
                cur = []
            cur.append(item)
        if cur:
            out.append({"size": layout.get("size"), key: cur})
    # Every batch carries the station blocks, so the game script can skip track on station tiles.
    if layout.get("stations"):
        for part in out[1:]:
            part["stations_skip"] = layout["stations"]
    return out


def cmd_build_layout(a):
    with open(a.file) as f:
        layout = json.load(f)
    adm = connect()
    built, failed = 0, []
    ox, oy = a.x, a.y
    try:
        if a.find_clear:
            w, h = layout["size"]
            r = gs(adm, {"cmd": "find_clear", "w": w + 4, "h": h + 4}, timeout=600)
            ox, oy = r["x"] + 2, r["y"] + 2
            print("origin=%d,%d" % (ox, oy), end=" ")
        elif ox is None or oy is None:
            raise Fail("give X Y or --find-clear")
        for part in layout_batches(layout):
            msg = {"cmd": "build_layout", "origin_x": ox, "origin_y": oy, "layout": part}
            if a.railtype:
                msg["railtype"] = a.railtype
            r = gs(adm, msg, timeout=600)
            built += r["built"]
            failed += r["failed"]
    finally:
        adm.close()
    print("built=%d failed=%d" % (built, len(failed)))
    for f in failed:
        print("  %s at %d,%d: %s" % (f["what"], f["x"], f["y"], f["error"]))
    if failed:
        sys.exit(1)


# D138 design train (loaded): hp, N, t, air drag, max speed. junction_export needs it (D137).
DESIGN_TRAIN = "14194,1090000,561,25,196"


def junction_here(x, y, rot=0, mirror=False, ml="L_R", branch="L_R", tl=4, near=False, instant=False, prio=None):
    """Generate at tile x,y via rcon junction_export and build it. prio: coverage in tiles (non-strict), else sized. Returns (status, text); status ok|error|failed."""
    tile = y * S.map_size() + x
    path = os.path.join(S.RUNDIR, "junction_export.json")
    if os.path.exists(path):
        os.remove(path)
    adm = connect()
    try:
        out = adm.rcon("junction_export %d %d %d %s %s %s %d %d" % (tile, rot, 1 if mirror else 0, path, ml, branch, tl, 2 if instant else (1 if near else 0)) + " train=" + DESIGN_TRAIN + ("" if prio is None else " prio=%d" % prio), timeout=1200)
        if not os.path.exists(path):
            raise Fail("junction_export wrote nothing: %s" % " | ".join(out))
        with open(path) as f:
            layout = json.load(f)
        if "error" in layout:
            return "error", layout["error"]
        ox, oy = layout["origin"]
        timing = ""
        for line in out:
            if "snapshot_us=" in line:
                timing = " " + line[line.index("snapshot_us="):].strip()
        built, failed = 0, []
        for part in layout_batches(layout):
            msg = {"cmd": "build_layout", "origin_x": ox, "origin_y": oy, "layout": part}
            if a.railtype:
                msg["railtype"] = a.railtype
            r = gs(adm, msg, timeout=600)
            built += r["built"]
            failed += r["failed"]
    finally:
        adm.close()
    text = "built=%d failed=%d" % (built, len(failed))
    if near or instant:
        text += " offset=%d,%d" % tuple(layout.get("offset", [0, 0])) + timing
    for f in failed:
        text += "\n  %s at %d,%d: %s" % (f["what"], f["x"], f["y"], f["error"])
    return ("failed" if failed else "ok"), text


def cmd_station_here(a):
    """Generate a station at tile x,y via rcon station_export and build it."""
    tile = a.y * S.map_size() + a.x
    path = os.path.join(S.RUNDIR, "station_export.json")
    if os.path.exists(path):
        os.remove(path)
    adm = connect()
    try:
        out = adm.rcon("station_export %d %d %d %s %d %d" % (tile, a.rot, 1 if a.mirror else 0, path, a.platforms, a.tl), timeout=1200)
        if not os.path.exists(path):
            raise Fail("station_export wrote nothing: %s" % " | ".join(out))
        with open(path) as f:
            layout = json.load(f)
        if "error" in layout:
            print("error %s" % layout["error"])
            sys.exit(3)
        ox, oy = layout["origin"]
        built, failed = 0, []
        for part in layout_batches(layout):
            msg = {"cmd": "build_layout", "origin_x": ox, "origin_y": oy, "layout": part}
            if a.railtype:
                msg["railtype"] = a.railtype
            r = gs(adm, msg, timeout=600)
            built += r["built"]
            failed += r["failed"]
    finally:
        adm.close()
    print("built=%d failed=%d" % (built, len(failed)))
    for f in failed:
        print("  %s at %d,%d: %s" % (f["what"], f["x"], f["y"], f["error"]))
    if failed:
        sys.exit(1)


def cmd_junction_here(a):
    st, text = junction_here(a.x, a.y, a.rot, a.mirror, a.ml, a.branch, a.tl, a.near or a.instant, a.instant, a.prio)
    print(text if st != "error" else "error %s" % text)
    sys.exit({"ok": 0, "error": 3, "failed": 1}[st])


def cmd_junction_scan(a):
    import random
    rng = random.Random(a.seed)
    n = S.map_size()
    tot = dict(generated=0, nolayout=0, ok=0, failed=0, errors=0)
    adm = connect()
    try:
        print("loan max, balance=%d" % gs(adm, {"cmd": "loan_max"})["balance"])
    finally:
        adm.close()
    for k in range(a.count):
        x, y, rot = rng.randrange(20, n - 20), rng.randrange(20, n - 20), rng.randrange(4)
        try:
            st, text = junction_here(x, y, rot, near=a.near or a.instant, instant=a.instant)
        except Exception as e:
            st, text = "exception", "exception %s: %s" % (type(e).__name__, e)
        if st == "exception":
            tot["errors"] += 1
        elif st == "error":
            tot["nolayout"] += 1
        else:
            tot["generated"] += 1
            tot["ok" if st == "ok" else "failed"] += 1
        print("try %d tile=%d,%d rot=%d: %s" % (k + 1, x, y, rot, text))
    print("generated=%d no_layout=%d built_ok=%d build_failures=%d rig_errors=%d" % (tot["generated"], tot["nolayout"], tot["ok"], tot["failed"], tot["errors"]))


