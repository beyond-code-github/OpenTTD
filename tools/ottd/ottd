            v["id"], v["n"], v["min"], v["max"], v["avg"], v["stops"], len(v["drops"])))
    deadlock_verdict(vids)


def heatmap(layout, ox, oy, r):
    w, h = layout["size"]
    stopped = {(x - ox, y - oy): n for x, y, n in r["stopped"]}
    slow = {(x - ox, y - oy): n for x, y, n in r["slow"]}
    track = {(t["x"], t["y"]) for t in layout.get("tracks", [])}
    heads, mids = set(), set()
    for b in layout.get("bridges", []):
        (x1, y1), (x2, y2) = b["start"], b["end"]
        heads.update([(x1, y1), (x2, y2)])
        for x in range(min(x1, x2) + 1, max(x1, x2)):
            for y in range(min(y1, y2) + 1, max(y1, y2)):
                mids.add((x, y))
    maxn = max(stopped.values()) if stopped else 0
    hdr = [" "] * w
    for x in range(0, w, 5):
        for k, ch in enumerate(str(x)):
            if x + k < w:
                hdr[x + k] = ch
    lines = ["    " + "".join(hdr)]
    for y in range(h):
        row = ""
        for x in range(w):
            t = (x, y)
            if t in stopped:
                row += str(-(-9 * stopped[t] // maxn))
            elif t in slow:
                row += "+"
            elif t in track or t in heads:
                row += "#"
            elif t in mids:
                row += "="
            else:
                row += "."
        lines.append("%3d %s" % (y, row))
    return lines, stopped, (set(stopped) | set(slow)) - {(x, y) for x in range(w) for y in range(h)}


def cmd_traffic(a):
    with open(a.file) as f:
        layout = json.load(f)
    mix = None
    if a.mix:
        mix = {k: int(v) for k, v in (p.split(":") for p in a.mix.split(","))}
    adm = connect()
    try:
        if mix:
            ox, oy, vids, cls = setup_circuit(adm, layout, a, mix)
        else:
            ox, oy, vids = setup_circuit(adm, layout, a)
        occ = {"cmd": "occupancy", "vehicles": vids, "ticks": a.ticks, "every": a.every}
        if mix:
            jx, jy, jw, jh = layout["junction"]
            occ["box"] = [ox + jx, oy + jy, jw, jh]
        wait_days(adm, a.warmup, 60 + 2 * a.warmup)
        r = gs(adm, occ, timeout=120 + a.ticks)
    finally:
        adm.close()
    lines, stopped, outside = heatmap(layout, ox, oy, r)
    print("heatmap (layout-relative; digit = stopped, 9 = busiest tile; + slow only; # track; = bridge middle)")
    print("\n".join(lines))
    n = r["samples"]
    print("samples=%d, tiles outside the layout box with stopped/slow samples: %d" % (n, len(outside)))
    print("top stopped tiles:")
    for t, c in sorted(stopped.items(), key=lambda kv: -kv[1])[:10]:
        print("  %d,%d n=%d %.1f%%" % (t[0], t[1], c, 100.0 * c / n))
    print("stop events per train: %s" % " ".join("%d:%d" % (s_[0], s_[1]) for s_ in r["stops"]))
    ml_box = 0
    if mix:
        for c in ("ml", "bw", "be"):
            ent = [s_ for s_ in r["stops"] if cls[s_[0]] == c]
            nb = sum(s_[2] for s_ in ent)
            tot = n * len(ent)
            print("class %s: trains=%d stop_events=%d stopped_in_junction=%d (%.2f%% of %d samples)" % (
                c, len(ent), sum(s_[1] for s_ in ent), nb, 100.0 * nb / tot if tot else 0.0, tot))
            if c == "ml":
                ml_box = nb
    path = os.path.join(S.RUNDIR, "traffic-%d.json" % int(time.time()))
    with open(path, "w") as f:
        json.dump({"params": {"file": a.file, "trains": a.trains, "wagons": a.wagons, "warmup": a.warmup, "ticks": a.ticks, "every": a.every, "origin": [ox, oy]}, "reply": r}, f)
    print(path)
    if mix:
        print("ML STOPPED IN JUNCTION: %d" % ml_box)
    deadlock_verdict(vids)


