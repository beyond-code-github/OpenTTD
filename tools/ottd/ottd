#!/usr/bin/env python3
"""ottd: terse CLI for the OpenTTD test rig. See tools/ottd/README.md."""
import argparse, json, os, re, sys, time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ottd_core import admin as A, format as F, server as S


class Fail(Exception):
    pass


def connect():
    if not S.pid():
        raise Fail("server not running (ottd start)")
    return A.Admin(port=S.PORT, password=S.PASSWORD)


def gs(adm, obj, timeout=60):
    r = adm.gs_request(obj, timeout=timeout)
    if "error" in r:
        raise Fail("%s: %s" % (obj["cmd"], r["error"]))
    return r


def one_shot(obj, timeout=60):
    adm = connect()
    try:
        return gs(adm, obj, timeout)
    finally:
        adm.close()


def companies(adm):
    """Return [(gs_company_id, line)] from rcon 'companies' (display ids are 1-based)."""
    out = []
    for line in adm.rcon("companies"):
        m = re.match(r"#:(\d+)\(", line)
        if m:
            out.append((int(m.group(1)) - 1, line))
    return out


def cmd_start(a):
    n = S.start(save=a.save, scenario=a.scenario, hilly=a.hilly)
    print("started pid=%d rundir=%s" % (n, S.RUNDIR))
    print("join: build/openttd -n 127.0.0.1")


def cmd_stop(a):
    print("stopped" if S.stop() else "not running")


def cmd_status(a):
    adm = connect()
    try:
        print(" ".join(adm.rcon("getdate")))
        cs = companies(adm)
        print("companies: %d" % len(cs))
        for cid, line in cs:
            m = re.search(r"Money: (-?\d+)", line)
            print("  company %d money=%s%s" % (cid, m.group(1) if m else "?", " AI" if line.rstrip().endswith("AI") else ""))
    finally:
        adm.close()


def cmd_rcon(a):
    adm = connect()
    try:
        for l in adm.rcon(a.command):
            print(l)
    finally:
        adm.close()


def cmd_gs(a):
    r = one_shot(json.loads(a.json))
    print(F.compact(r))
    if "error" in r:
        sys.exit(1)


def cmd_company(a):
    adm = connect()
    try:
        cs = companies(adm)
        if a.id is not None:
            if a.id not in [c[0] for c in cs]:
                raise Fail("no company %d (have: %s)" % (a.id, ",".join(str(c[0]) for c in cs) or "none"))
            cs = [c for c in cs if c[0] == a.id]
        elif not cs:
            adm.rcon("start_ai %s" % S.AI_NAME)
            for _ in range(40):
                time.sleep(0.25)
                cs = companies(adm)
                if cs:
                    break
        if not cs:
            raise Fail("start_ai %s produced no company (see %s)" % (S.AI_NAME, os.path.join(S.RUNDIR, "server.log")))
        cid = cs[0][0]
        gs(adm, {"cmd": "company_set", "company": cid})
        print("company %d set" % cid)
    finally:
        adm.close()


def cmd_build_line(a):
    one_shot({"cmd": "build_rail", "x1": a.x1, "y1": a.y1, "x2": a.x2, "y2": a.y2})
    print("rail %d,%d-%d,%d ok" % (a.x1, a.y1, a.x2, a.y2))


def cmd_depot(a):
    one_shot({"cmd": "build_depot", "x": a.x, "y": a.y, "dir": a.dir})
    print("depot %d,%d %s ok" % (a.x, a.y, a.dir.upper()))


def cmd_train(a):
    req = {"cmd": "build_train", "depot_x": a.depot_x, "depot_y": a.depot_y, "wagons": a.wagons}
    if a.engine is not None:
        req["engine"] = a.engine
    r = one_shot(req)
    print("train %d engine=%d (%s) wagons=%d" % (r["vehicle"], r["engine"], r["engine_name"], r["wagons"]))


def cmd_orders(a):
    r = one_shot({"cmd": "orders_depots", "vehicle": a.vehicle, "x1": a.x1, "y1": a.y1, "x2": a.x2, "y2": a.y2})
    print("vehicle %d orders=%d" % (a.vehicle, r["orders"]))


def cmd_go(a):
    one_shot({"cmd": "start", "vehicle": a.vehicle})
    print("vehicle %d started" % a.vehicle)


def layout_batches(layout, limit=1200):
    """Split a layout into pieces small enough for one admin packet, keeping build order:
    all tracks, then all bridges, then all signals."""
    def size(l):
        return len(json.dumps(l, separators=(",", ":")))
    out = []
    for key in ("tracks", "bridges", "signals"):
        cur = []
        for item in layout.get(key, []):
            if cur and size({key: cur + [item]}) > limit:
                out.append({"size": layout.get("size"), key: cur})
                cur = []
            cur.append(item)
        if cur:
            out.append({"size": layout.get("size"), key: cur})
    return out


def cmd_build_layout(a):
    with open(a.file) as f:
        layout = json.load(f)
    adm = connect()
    built, failed = 0, []
    ox, oy = a.x, a.y
    try:
        if a.find_clear:
            w, h = layout["size"]
            r = gs(adm, {"cmd": "find_clear", "w": w + 4, "h": h + 4}, timeout=600)
            ox, oy = r["x"] + 2, r["y"] + 2
            print("origin=%d,%d" % (ox, oy), end=" ")
        elif ox is None or oy is None:
            raise Fail("give X Y or --find-clear")
        for part in layout_batches(layout):
            r = gs(adm, {"cmd": "build_layout", "origin_x": ox, "origin_y": oy, "layout": part}, timeout=600)
            built += r["built"]
            failed += r["failed"]
    finally:
        adm.close()
    print("built=%d failed=%d" % (built, len(failed)))
    for f in failed:
        print("  %s at %d,%d: %s" % (f["what"], f["x"], f["y"], f["error"]))
    if failed:
        sys.exit(1)


def junction_here(x, y, rot=0, mirror=False, ml="L_R", branch="L_R", tl=4):
    """Generate at tile x,y via rcon junction_export and build it. Returns (status, text); status ok|error|failed."""
    tile = y * S.map_size() + x
    path = os.path.join(S.RUNDIR, "junction_export.json")
    if os.path.exists(path):
        os.remove(path)
    adm = connect()
    try:
        out = adm.rcon("junction_export %d %d %d %s %s %s %d" % (tile, rot, 1 if mirror else 0, path, ml, branch, tl))
        if not os.path.exists(path):
            raise Fail("junction_export wrote nothing: %s" % " | ".join(out))
        with open(path) as f:
            layout = json.load(f)
        if "error" in layout:
            return "error", layout["error"]
        ox, oy = layout["origin"]
        built, failed = 0, []
        for part in layout_batches(layout):
            r = gs(adm, {"cmd": "build_layout", "origin_x": ox, "origin_y": oy, "layout": part}, timeout=600)
            built += r["built"]
            failed += r["failed"]
    finally:
        adm.close()
    text = "built=%d failed=%d" % (built, len(failed))
    for f in failed:
        text += "\n  %s at %d,%d: %s" % (f["what"], f["x"], f["y"], f["error"])
    return ("failed" if failed else "ok"), text


def cmd_junction_here(a):
    st, text = junction_here(a.x, a.y, a.rot, a.mirror, a.ml, a.branch, a.tl)
    print(text if st != "error" else "error %s" % text)
    sys.exit({"ok": 0, "error": 3, "failed": 1}[st])


def cmd_junction_scan(a):
    import random
    rng = random.Random(a.seed)
    n = S.map_size()
    tot = dict(generated=0, nolayout=0, ok=0, failed=0, errors=0)
    for k in range(a.count):
        x, y, rot = rng.randrange(20, n - 20), rng.randrange(20, n - 20), rng.randrange(4)
        try:
            st, text = junction_here(x, y, rot)
        except Exception as e:
            st, text = "exception", "exception %s: %s" % (type(e).__name__, e)
        if st == "exception":
            tot["errors"] += 1
        elif st == "error":
            tot["nolayout"] += 1
        else:
            tot["generated"] += 1
            tot["ok" if st == "ok" else "failed"] += 1
        print("try %d tile=%d,%d rot=%d: %s" % (k + 1, x, y, rot, text))
    print("generated=%d no_layout=%d built_ok=%d build_failures=%d rig_errors=%d" % (tot["generated"], tot["nolayout"], tot["ok"], tot["failed"], tot["errors"]))


def cmd_sample(a):
    r = one_shot({"cmd": "sample", "vehicles": a.vehicles, "ticks": a.ticks}, timeout=60 + a.ticks)
    for v in r["vehicles"]:
        print("vehicle %d: n=%d speed min=%d max=%d avg=%d km/h stops=%d drops=%d" % (
            v["id"], v["n"], v["min"], v["max"], v["avg"], v["stops"], len(v["drops"])))
        for d in v["drops"]:
            print("  drop at %d,%d: %d -> %d km/h" % (d["tile_x"], d["tile_y"], d["from"], d["to"]))


def cmd_junction_check(a):
    with open(a.file) as f:
        layout = json.load(f)
    adm = connect()
    try:
        r = gs(adm, {"cmd": "loan_max"})
        print("loan max, balance=%d" % r["balance"])
        ox, oy = a.x, a.y
        if a.find_clear:
            w, h = layout["size"]
            r = gs(adm, {"cmd": "find_clear", "w": w + 4, "h": h + 4}, timeout=600)
            ox, oy = r["x"] + 2, r["y"] + 2
        elif ox is None or oy is None:
            raise Fail("give X Y or --find-clear")
        print("origin=%d,%d" % (ox, oy))
        built, failed = 0, []
        for part in layout_batches(layout):
            r = gs(adm, {"cmd": "build_layout", "origin_x": ox, "origin_y": oy, "layout": part}, timeout=600)
            built += r["built"]
            failed += r["failed"]
        print("built=%d failed=%d" % (built, len(failed)))
        for f in failed:
            print("  %s at %d,%d: %s" % (f["what"], f["x"], f["y"], f["error"]))
        if failed:
            sys.exit(1)
        depots = layout.get("depots", [])
        if not depots:
            raise Fail("layout has no depots")
        for d in depots:
            gs(adm, {"cmd": "build_depot", "x": ox + d["x"], "y": oy + d["y"], "dir": d["dir"]})
            print("depot %d,%d %s ok" % (ox + d["x"], oy + d["y"], d["dir"]))
        d0 = depots[0]
        dx, dy = ox + d0["x"], oy + d0["y"]
        vids = []
        for i in range(a.trains):
            r = gs(adm, {"cmd": "build_train", "depot_x": dx, "depot_y": dy, "wagons": 3})
            vids.append(r["vehicle"])
            gs(adm, {"cmd": "start", "vehicle": r["vehicle"]})
            if i + 1 < a.trains:
                d_start = gs(adm, {"cmd": "ping"})["date"]
                t0 = time.time()
                while time.time() - t0 < 30:
                    time.sleep(0.2)
                    if gs(adm, {"cmd": "ping"})["date"] - d_start >= 4:  # about 300 ticks (74 ticks/day)
                        break
        print("trains %s" % ",".join(str(v) for v in vids))
        r = gs(adm, {"cmd": "sample", "vehicles": vids, "ticks": a.ticks}, timeout=120 + a.ticks)
    finally:
        adm.close()
    ok = False
    for v in r["vehicles"]:
        print("vehicle %d: n=%d speed min=%d max=%d avg=%d km/h stops=%d drops=%d" % (
            v["id"], v["n"], v["min"], v["max"], v["avg"], v["stops"], len(v["drops"])))
    adm = connect()
    try:
        snaps = []
        for k in range(2):
            snaps.append({v["id"]: (v["x"], v["y"], v["speed"]) for v in gs(adm, {"cmd": "vehicles"})["vehicles"] if v["id"] in vids})
            if k == 0:
                d0_ = gs(adm, {"cmd": "ping"})["date"]
                while gs(adm, {"cmd": "ping"})["date"] - d0_ < 14:  # about 1000 ticks
                    time.sleep(0.2)
    finally:
        adm.close()
    dead = all(snaps[0][v][2] == 0 and snaps[1][v][2] == 0 and snaps[0][v][:2] == snaps[1][v][:2] for v in vids)
    print("DEADLOCK?" if dead else "OK")
    sys.exit(2 if dead else 0)


def cmd_vehicles(a):
    for l in F.vehicles(one_shot({"cmd": "vehicles"})):
        print(l)


def cmd_watch(a):
    adm = connect()
    samples, states = [], set()
    try:
        end = time.time() + a.seconds
        while time.time() < end:
            t0 = time.time()
            r = gs(adm, {"cmd": "vehicles"})
            for v in r["vehicles"]:
                if v["id"] == a.vehicle:
                    samples.append((v["speed"], v["state"]))
                    states.add(v["state"])
            time.sleep(max(0, 0.5 - (time.time() - t0)))
    finally:
        adm.close()
    if not samples:
        raise Fail("vehicle %d not found" % a.vehicle)
    print(F.watch_summary(a.vehicle, samples) + " states=" + ",".join(sorted(states)))


def main():
    ap = argparse.ArgumentParser(prog="ottd", description="OpenTTD test rig CLI")
    sub = ap.add_subparsers(dest="cmd", required=True)

    def add(name, fn, *args, **kw):
        p = sub.add_parser(name, **kw)
        for spec, opts in args:
            p.add_argument(spec, **opts)
        p.set_defaults(fn=fn)

    i = {"type": int}
    add("start", cmd_start, ("--save", {}), ("--scenario", {}), ("--hilly", {"action": "store_true"}))
    add("stop", cmd_stop)
    add("status", cmd_status)
    add("rcon", cmd_rcon, ("command", {}))
    add("gs", cmd_gs, ("json", {}))
    add("company", cmd_company, ("--id", i))
    add("build-layout", cmd_build_layout, ("file", {}), ("x", {"type": int, "nargs": "?"}), ("y", {"type": int, "nargs": "?"}), ("--find-clear", {"action": "store_true"}))
    add("junction-check", cmd_junction_check, ("file", {}), ("x", {"type": int, "nargs": "?"}), ("y", {"type": int, "nargs": "?"}), ("--find-clear", {"action": "store_true"}), ("--trains", {"type": int, "default": 6}), ("--ticks", {"type": int, "default": 7400}))
    add("junction-here", cmd_junction_here, ("x", i), ("y", i), ("--rot", {"type": int, "default": 0}), ("--mirror", {"action": "store_true"}), ("--ml", {"default": "L_R"}), ("--branch", {"default": "L_R"}), ("--tl", {"type": int, "default": 4}))
    add("junction-scan", cmd_junction_scan, ("--count", {"type": int, "required": True}), ("--seed", {"type": int, "default": 1}))
    add("sample", cmd_sample, ("vehicles", {"type": int, "nargs": "+"}), ("--ticks", {"type": int, "required": True}))
    add("build-line", cmd_build_line, ("x1", i), ("y1", i), ("x2", i), ("y2", i))
    add("depot", cmd_depot, ("x", i), ("y", i), ("dir", {"help": "NE|SE|SW|NW: direction the entrance faces (NE x-1, SE y+1, SW x+1, NW y-1)"}))
    add("train", cmd_train, ("depot_x", i), ("depot_y", i), ("--engine", i), ("--wagons", {"type": int, "default": 0}))
    add("orders", cmd_orders, ("vehicle", i), ("x1", i), ("y1", i), ("x2", i), ("y2", i))
    add("go", cmd_go, ("vehicle", i))
    add("vehicles", cmd_vehicles)
    add("watch", cmd_watch, ("vehicle", i), ("--seconds", {"type": float, "default": 10}))
    a = ap.parse_args()
    try:
        a.fn(a)
    except Fail as e:
        print("FAIL: %s" % e, file=sys.stderr)
        sys.exit(1)
    except Exception as e:
        print("FAIL: %s: %s" % (type(e).__name__, e), file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
