def setup_circuit(adm, layout, a, mix=None):
    """Loan, find origin, build layout and depots, buy and start a.trains trains. Returns (ox, oy, vids)."""
    r = gs(adm, {"cmd": "loan_max"})
    print("loan max, balance=%d" % r["balance"])
    ox, oy = a.x, a.y
    if a.find_clear:
        w, h = layout["size"]
        r = gs(adm, {"cmd": "find_clear", "w": w + 4, "h": h + 4}, timeout=600)
        ox, oy = r["x"] + 2, r["y"] + 2
    elif ox is None or oy is None:
        raise Fail("give X Y or --find-clear")
    print("origin=%d,%d" % (ox, oy))
    built, failed = 0, []
    for part in layout_batches(layout):
        r = gs(adm, {"cmd": "build_layout", "origin_x": ox, "origin_y": oy, "layout": part}, timeout=600)
        built += r["built"]
        failed += r["failed"]
    print("built=%d failed=%d" % (built, len(failed)))
    for f in failed:
        print("  %s at %d,%d: %s" % (f["what"], f["x"], f["y"], f["error"]))
    if failed:
        sys.exit(1)
    depots = layout.get("depots", [])
    if not depots:
        raise Fail("layout has no depots")
    for d in depots:
        gs(adm, {"cmd": "build_depot", "x": ox + d["x"], "y": oy + d["y"], "dir": d["dir"]})
        print("depot %d,%d %s ok" % (ox + d["x"], oy + d["y"], d["dir"]))
    d0 = depots[0]
    dx, dy = ox + d0["x"], oy + d0["y"]
    vids = []
    classes = []
    via = {}
    if mix:
        wps = {w["name"]: w for w in layout.get("waypoints", [])}
        for w in wps.values():
            gs(adm, {"cmd": "build_waypoint", "x": ox + w["x"], "y": oy + w["y"]})
            print("waypoint %s %d,%d ok" % (w["name"], ox + w["x"], oy + w["y"]))
        routes = {"ml": ["west", "east"], "bw": ["south", "west"], "be": ["south", "east"]}
        left = dict(mix)
        while sum(left.values()) > 0:
            for c in ("ml", "bw", "be"):
                if left.get(c, 0) > 0:
                    classes.append(c)
                    left[c] -= 1
        for c in classes:
            via.setdefault(c, [[ox + wps[n]["x"], oy + wps[n]["y"]] for n in routes[c]])
        ntrains = len(classes)
    else:
        ntrains = a.trains
    for i in range(ntrains):
        r = gs(adm, {"cmd": "build_train", "depot_x": dx, "depot_y": dy, "wagons": a.wagons})
        vids.append(r["vehicle"])
        if mix:
            gs(adm, {"cmd": "orders_via", "vehicle": r["vehicle"], "tiles": via[classes[i]]})
        gs(adm, {"cmd": "start", "vehicle": r["vehicle"]})
        if i + 1 < ntrains:
            wait_days(adm, 4, 30)  # about 300 ticks (74 ticks/day)
    print("trains %s" % ",".join(str(v) for v in vids))
    if mix:
        print("classes %s" % " ".join("%d:%s" % (v, c) for v, c in zip(vids, classes)))
        return ox, oy, vids, dict(zip(vids, classes))
    return ox, oy, vids


def wait_days(adm, days, limit):
    d_start = gs(adm, {"cmd": "ping"})["date"]
    t0 = time.time()
    while time.time() - t0 < limit:
        time.sleep(0.2)
        if gs(adm, {"cmd": "ping"})["date"] - d_start >= days:
            break


def deadlock_verdict(vids):
    """Two vehicles snapshots about 1000 ticks apart; prints DEADLOCK? or OK and exits 2 or 0."""
    adm = connect()
    try:
        snaps = []
        for k in range(2):
            snaps.append({v["id"]: (v["x"], v["y"], v["speed"]) for v in gs(adm, {"cmd": "vehicles"})["vehicles"] if v["id"] in vids})
            if k == 0:
                d0_ = gs(adm, {"cmd": "ping"})["date"]
                while gs(adm, {"cmd": "ping"})["date"] - d0_ < 14:  # about 1000 ticks
                    time.sleep(0.2)
    finally:
        adm.close()
    dead = all(snaps[0][v][2] == 0 and snaps[1][v][2] == 0 and snaps[0][v][:2] == snaps[1][v][:2] for v in vids)
    print("DEADLOCK?" if dead else "OK")
    sys.exit(2 if dead else 0)


def cmd_junction_check(a):
    with open(a.file) as f:
        layout = json.load(f)
    adm = connect()
    try:
        ox, oy, vids = setup_circuit(adm, layout, a)
        r = gs(adm, {"cmd": "sample", "vehicles": vids, "ticks": a.ticks}, timeout=120 + a.ticks)
    finally:
        adm.close()
    for v in r["vehicles"]:
