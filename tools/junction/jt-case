#!/bin/sh
# Runs one test case for jt: jt-case <openttd_test> <spec> <log> <budget-s>.
# The case is killed after its budget, and its log is capped at 1 MiB (ulimit -f in 512-byte blocks).
# A case that dies or reaches the cap fails. A runaway case once wrote 100 GB of log and took WSL down (2026-11-26).
# The cap is set in a subshell so that only the case gets SIGXFSZ, not this script.
( ulimit -f 2048; exec timeout -k 2 "$4" "$1" "$2" --durations yes ) > "$3" 2>&1
rc=$?
[ "$(stat -c %s "$3")" -ge 1048576 ] && { echo "jt: log capped at 1 MiB (runaway output)" >> "$3"; rc=1; }
exit $rc
