#!/usr/bin/env bash
# Junction test runner with enforced time budgets (docs/junction-tool/TESTS.md).
#   jt fast <build-dir> <tag> [budget-seconds=5]   run "<tag>~[slow]~[.]" (no slow or hidden tests), fail if over budget
#   jt gate <build-dir>                             wide gate, Release builds only
#   jt identity <build-dir>                         the identity sweeps "[identity]", Release builds only
#   jt sweep <build-dir>                            the slow gate sweeps "[.sweep]", Release builds only
# Builds openttd_test first (a build failure fails the run). Output goes to <build-dir>/jt-<name>.log; only failures, slow tests and the total are printed.
set -u
mode=${1:-}; build=${2:-}
if [ -z "$mode" ] || [ -z "$build" ] || [ ! -x "$build/openttd_test" ]; then
	echo "usage: jt fast <build-dir> <tag> [budget-s] | jt gate <build-dir> | jt identity <build-dir> | jt sweep <build-dir>" >&2; exit 2
fi
type=$(grep -m1 '^CMAKE_BUILD_TYPE' "$build/CMakeCache.txt" 2>/dev/null | cut -d= -f2)
case "$mode" in
	fast)
		tag=${3:?tag}; budget=${4:-5}
		case "$tag" in \[*\]) ;; *) echo "jt: tag must be in brackets, e.g. '[projection]' (got '$tag')" >&2; exit 2;; esac
		filter="${tag}~[slow]~[.]"
		name=$(echo "$tag" | tr -c 'a-zA-Z0-9' '_')
		;;
	gate)
		if [ "$type" != "Release" ]; then echo "jt gate: $build is '$type', not Release; the wide gate runs in Release only" >&2; exit 2; fi
		filter="[junction]~[slow]~[mapexport]~[.]"; budget=${3:-120}; name=gate
		;;
	identity)
		if [ "$type" != "Release" ]; then echo "jt identity: $build is '$type', not Release; the identity sweeps run in Release only" >&2; exit 2; fi
		filter="[identity]"; budget=${3:-90}; name=identity
		;;
	sweep)
		if [ "$type" != "Release" ]; then echo "jt sweep: $build is '$type', not Release; the slow sweeps run in Release only" >&2; exit 2; fi
		filter="[.sweep]"; budget=${3:-300}; name=sweep
		;;
	*) echo "jt: unknown mode $mode" >&2; exit 2;;
esac
log="$build/jt-$name.log"
# Build first: a failed build must fail the run, never test a stale binary.
if ! cmake --build "$build" --target openttd_test -j16 > "$build/jt-build.log" 2>&1; then
	echo "jt: BUILD FAILED ($build/jt-build.log):" >&2; grep -m10 -E 'error|Error' "$build/jt-build.log" >&2; exit 1
fi
start=$(date +%s%N)
timeout --signal=INT "$((budget + 1))" "$build/openttd_test" "$filter" --durations yes > "$log" 2>&1
rc=$?
ms=$(( ($(date +%s%N) - start) / 1000000 ))
grep -E '^[0-9]+\.[0-9]+ s: ' "$log" | awk -F' s: ' '$1 >= 1.0' | sort -rn | head -10 | sed 's/^/  slow test: /'
grep -E '(^|: )FAILED|error:' "$log" | head -20
tail -3 "$log" | grep -E 'test cases|All tests passed'
printf 'jt %s %s (%s): %d.%03d s, budget %s s\n' "$mode" "$filter" "${type:-?}" $((ms / 1000)) $((ms % 1000)) "$budget"
if grep -q 'No tests ran' "$log"; then echo "jt: NO TESTS RAN for $filter (a tag typo is not a pass)"; exit 4; fi
if [ "$rc" = 124 ] || [ "$rc" = 130 ] || [ "$ms" -gt $((budget * 1000)) ]; then echo "jt: OVER BUDGET (stop condition)"; exit 3; fi
exit $rc
