+/** The Y class of the piece a layout tile (template layout frame) holds: a piece, a free diagonal's interior or an X-free link's interior; nullopt when none (a Y-free link's interior is a straight Y piece). */
+static std::optional<uint16_t> NodeYClassAt(const JunctionNodeTemplate &tpl, const std::vector<int> &values, int x, int y)
+{
+	auto shift = [&](uint16_t cls) { return values[cls] - tpl.flat[cls]; };
+	for (const JunctionNodePiece &piece : tpl.pieces) {
+		if (piece.on_bridge) continue;
+		if (piece.tile.x + shift(piece.cls) == x && piece.tile.y + shift(piece.ycls) == y) return piece.ycls;
+	}
+	for (const JunctionNodeDiagonal &diag : tpl.diagonals) {
+		const JunctionNodePoint &from = tpl.points[tpl.links[diag.link].from];
+		const JunctionRaster raster = NodeDiagonalRaster(tpl, diag, diag.halves + 2 * NodeDiagonalSteps(tpl, diag, values));
+		for (size_t i = 1; i + 1 < raster.pieces.size(); i++) {
+			if (raster.pieces[i].tile.x + shift(from.cls) == x && raster.pieces[i].tile.y + shift(from.ycls) == y) return from.ycls;
+		}
+	}
+	for (const JunctionNodeLink &link : tpl.links) {
+		if (!link.free || link.diagonal || link.axis != Axis::X) continue;
+		const JunctionNodePoint &from = tpl.points[link.from];
+		const JunctionNodePoint &to = tpl.points[link.to];
+		if (from.tile.y + shift(from.ycls) != y) continue;
+		const int x_from = from.tile.x + shift(from.cls);
+		const int x_to = to.tile.x + shift(to.cls);
+		if (x > std::min(x_from, x_to) && x < std::max(x_from, x_to)) return from.ycls;
+	}
+	return std::nullopt;
+}
