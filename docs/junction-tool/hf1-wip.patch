+/**
+ * The heights a piece has on a tile at working (x, y), as the game derives them (DESIGN-N3 §10): two or more tracks on the tile, or a half piece, sit at the tile's z_max;
+ * an axis piece alone on its tile is a ramp or level, entry and exit from JunctionFacts::Straight (swapped for travel against the axis).
+ * @return Whether the piece can sit there.
+ */
+static bool NodeTileHeights(const JunctionFacts &facts, int x, int y, Trackdir td, TrackBits bits, int8_t &entry, int8_t &exit)
+{
+	if (bits.Count() >= 2 || !IsDiagonalTrackdir(td)) {
+		entry = exit = facts.Plane(x, y);
+		return entry != INT8_MIN;
+	}
+	const Axis axis = TrackdirToTrack(td) == Track::X ? Axis::X : Axis::Y;
+	const bool forward = td == Trackdir::X_SW || td == Trackdir::Y_SE;
+	if (!facts.Straight(x, y, axis, entry, exit)) return false;
+	if (!forward) std::swap(entry, exit);
+	return true;
+}
