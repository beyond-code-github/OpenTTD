+/** Heights of consecutive tiles of a path, checked as they are added (DESIGN-N3 §10). */
+struct NodeChain {
+	const JunctionFacts &facts;
+	bool ok = true; ///< Every tile so far has heights and each meets the one before.
+	bool started = false;
+	int8_t previous = 0; ///< The exit height of the last tile.
+
+	void Add(int x, int y, Trackdir td, TrackBits bits)
+	{
+		if (!this->ok) return;
+		int8_t entry;
+		int8_t exit;
+		this->ok = NodeTileHeights(this->facts, x, y, td, bits, entry, exit) && (!this->started || this->previous == entry);
+		this->started = true;
+		this->previous = exit;
+	}
+};
