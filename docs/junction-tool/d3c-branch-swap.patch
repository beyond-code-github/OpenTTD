+/** Every swap candidate that builds, over the sweep of D3c. */
+static const std::vector<SweepCandidate> &SwapCandidates(const JunctionSpec &spec)
+{
+	static const std::vector<SweepCandidate> out = [&spec]() {
+		std::vector<SweepCandidate> out;
+		const int leg = 2 * (spec.branch_gap + 1) + 2 * static_cast<int>((DeriveCurveSpacing(spec.reference_speed, spec.curve_speed, spec.tl) + 1) / 2) + 4;
+		for (int height = spec.ml_gap + 5; height <= spec.ml_gap + 20 + leg; height++) {
+			for (Money crossing_cost : {Money(0), spec.prices.bridge(3)}) {
+				for (uint8_t slack = 0; slack <= 3; slack++) {
+					const JunctionCandidateParams params{static_cast<uint8_t>(height), crossing_cost, slack, true};
+					std::optional<JunctionLayout> layout = BuildJunctionCandidate(spec, params);
+					if (layout.has_value()) out.push_back({params, std::move(*layout)});
+				}
+			}
+		}
+		return out;
+	}();
+	return out;
+}
+
+TEST_CASE("BuildJunctionCandidate: some swap candidate is clean", "[junction]")
+{
+	const JunctionSpec spec = MakeTestJunctionSpec();
+	const std::vector<SweepCandidate> &candidates = SwapCandidates(spec);
+	const SweepCandidate *clean = FirstClean(spec, candidates);
+	REQUIRE(clean != nullptr);
+	WARN("first clean swap: height " << static_cast<int>(clean->params.height) << " crossing_cost " << clean->params.crossing_cost
+			<< " joiner_slack " << static_cast<int>(clean->params.joiner_slack) << "\n" << RenderJunctionAscii(clean->layout));
+}
