+/** Spike (PLANAR_SHAPEFLOW): shape as a flow. Checks that every face's turns sum to -8 and solves the minimum-turn flow LPs; prints to PLANAR_SHAPEFLOW_OUT.<tag>. */
+static void ShapeFlow(const PlanarTopology &t, const PlanarChannels &chs, uint64_t over, const MappedComposer &C, const std::vector<int64_t> &val, const std::string &tag)
+{
+	const Clock::time_point t0 = Clock::now();
+	const Model &M = C.M;
+	const char *outp = std::getenv("PLANAR_SHAPEFLOW_OUT");
+	std::ofstream out(outp != nullptr ? fmt::format("{}.{}", outp, tag) : std::string("/dev/null"));
+	const auto turn = [](int a, int b, int face_sign) {
+		const int r = ((b - a) % 8 + 8) % 8;
+		const int v = r <= 4 ? r : r - 8;
+		return v == 4 ? 4 * face_sign : v;
+	};
+	const std::vector<PlanarSpikeFace> &faces = C.sides.SpikeWalks();
+	const int cross0 = C.sides.SpikeCross0();
+	if (faces.empty()) {
+		out << "no face walks\n";
+		return;
+	}
+
+	/* Stretches: headings of their non-zero segments, net turn, heading changes. */
+	struct Str {
+		std::vector<int> h;
+		int b = 0;
+		int changes = 0;
+		int cusps = 0;
+		bool ok = false;
+	};
+	std::map<std::pair<uint32_t, uint32_t>, Str> str;
+	int unusable = 0;
+	for (uint32_t l = 0; l < t.lines.size(); l++) {
+		const std::vector<Seg> &segs = M.strands.at(t.lines[l].name).segs;
+		for (uint32_t k = 0; k <= C.sides.Events()[l].size(); k++) {
+			Str &s = str[{l, k}];
+			const auto it = C.spike_ranges.find({l, k});
+			if (it == C.spike_ranges.end() || it->second.first < 0) {
+				unusable++;
+				continue;
+			}
+			for (int i = it->second.first; i <= it->second.second; i++) {
+				if (std::llround(Ev(val, segs[i].L)) != 0) s.h.push_back(segs[i].d);
+			}
+			s.ok = !s.h.empty();
+			if (!s.ok) {
+				unusable++;
+				continue;
+			}
+			for (size_t i = 0; i + 1 < s.h.size(); i++) {
+				const int v = turn(s.h[i], s.h[i + 1], -1);
+				s.b += v;
+				if (v != 0) s.changes++;
+				if (std::abs(v) == 4) s.cusps++;
+			}
+		}
+	}
+	out << "stretches " << str.size() << " unusable " << unusable << "\n";
+	if (unusable > 0) {
+		out << "STOP: stretch segment ranges not found\n";
+		return;
+	}
+
+	/* The ring: side and position of each ring end. */
+	const int nring = static_cast<int>(t.ring.size());
+	std::vector<PlanarSide> ring_side(nring, PlanarSide::N);
+	for (int i = 0; i < nring; i++) {
+		for (const PlanarPort &p : t.ports) {
+			if (std::ranges::find(p.lines, t.ring[i]) != p.lines.end()) ring_side[i] = p.side;
+		}
+	}
+	const auto ring_pt = [&](int i) {
+		const PlanarLine &ln = t.lines[t.ring[i]];
+		const Point p = ln.from.port ? M.strands.at(ln.name).start : M.End(ln.name);
+		return std::array<int64_t, 2>{std::llround(Ev(val, p[0])), std::llround(Ev(val, p[1]))};
+	};
+	/* ccw order N, W, S, E with the heading of a walk along each side, interior on the left. */
+	const auto ord = [](PlanarSide s) { return s == PlanarSide::N ? 0 : s == PlanarSide::W ? 1 : s == PlanarSide::S ? 2 : 3; };
+	const int box_h[4] = {6, 4, 2, 0};
+
+	/* Per face: items with heading lists. */
+	struct Item {
+		std::vector<int> h;
+		int line = -1;
+		uint32_t stretch = 0;
+		bool forward = true;
+		int head = 0;
+		int internal = 0; ///< Direct sum of the turns inside the item.
+	};
+	struct FaceData {
+		std::vector<Item> items;
+		int total = 0;
+		int fixed = 0; ///< Non-crossing vertex turns and ring arcs.
+		std::vector<int> cross; ///< Crossing vertex turns (rough).
+		struct Corner { int vertex; int v; bool A; int la; int lb; };
+		std::vector<Corner> cross_at; ///< Crossing corners (vertex, rough turn, type A = opposite arms same sign, the two lines).
+		bool inner = false;
+	};
+	std::vector<FaceData> fd(faces.size());
+	int failing = 0;
+	for (size_t f = 0; f < faces.size(); f++) {
+		if (faces[f].outer) continue;
+		FaceData &F = fd[f];
+		F.inner = true;
+		for (const PlanarSpikeDart &d : faces[f].darts) {
+			Item it;
+			it.head = d.head;
+			if (d.line >= 0) {
+				it.line = d.line;
+				it.stretch = static_cast<uint32_t>(d.stretch);
+				it.forward = d.forward;
+				const Str &s = str.at({static_cast<uint32_t>(d.line), static_cast<uint32_t>(d.stretch)});
+				if (d.forward) {
+					it.h = s.h;
+				} else {
+					for (size_t i = s.h.size(); i-- > 0;) it.h.push_back((s.h[i] + 4) % 8);
+				}
+			} else {
+				/* A ring edge walked against the ring: from ring end d.tail to d.head. */
+				const int sa = ord(ring_side[d.tail]), sb = ord(ring_side[d.head]);
+				const std::array<int64_t, 2> pa = ring_pt(d.tail), pb = ring_pt(d.head);
+				int steps = (sb - sa + 4) % 4;
+				if (steps == 0) {
+					const bool adv = sa == 0 ? pb[0] <= pa[0] : sa == 1 ? pb[1] >= pa[1] : sa == 2 ? pb[0] >= pa[0] : pb[1] <= pa[1];
+					if (!adv) steps = 4;
+				}
+				for (int k = 0; k <= steps; k++) it.h.push_back(box_h[(sa + k) % 4]);
+			}
+			for (size_t i = 0; i + 1 < it.h.size(); i++) it.internal += turn(it.h[i], it.h[i + 1], -1);
+			F.items.push_back(std::move(it));
+		}
+		for (size_t j = 0; j < F.items.size(); j++) {
+			const Item &a = F.items[j], &b = F.items[(j + 1) % F.items.size()];
+			const int v = turn(a.h.back(), b.h.front(), -1);
+			F.total += a.internal + v;
+			if (a.head >= cross0 && a.line >= 0 && b.line >= 0) {
+				F.cross_at.push_back({a.head, v, a.forward != b.forward, a.line, b.line});
+			} else {
+				F.fixed += v;
+			}
+			if (a.line < 0) F.fixed += a.internal;
+		}
+		if (F.total != -8) {
+			failing++;
+			out << "FAIL face " << f << " total " << F.total << ":";
+			for (const Item &it : F.items) {
+				if (it.line >= 0) {
+					out << " " << t.lines[it.line].name << "#" << it.stretch << (it.forward ? "+" : "-");
+				} else {
+					out << " box";
+				}
+				out << "[";
+				for (size_t i = 0; i < it.h.size(); i++) out << (i ? "," : "") << it.h[i];
+				out << "]";
+			}
+			out << "\n";
+		}
+	}
+	size_t inner_faces = 0;
+	for (const FaceData &F : fd) inner_faces += F.inner ? 1 : 0;
+	out << "faces " << faces.size() << " (inner " << inner_faces << ") failing " << failing << "\n";
+
+	const PlanarPaths spike_paths = BuildPlanarPaths(t, chs, over);
+	/* Jogs. */
+	int jogs = 0, jog_changes = 0, all_changes = 0, cusps = 0;
+	int rough_abs = 0;
+	for (const auto &[key, s] : str) {
+		all_changes += s.changes;
+		cusps += s.cusps;
+		rough_abs += std::abs(s.b);
+		if (s.b == 0 && s.changes > 0) {
+			jogs++;
+			jog_changes += s.changes;
+			const PlanarLine &ln = t.lines[key.first];
+			const auto endd = [&](const PlanarEnd &e) { return e.port ? fmt::format("P{}", e.index) : fmt::format("{}{}", t.nodes[e.index].IsSplit() ? "split" : "merge", e.index); };
+			out << "JOG " << ln.name << "#" << key.second << " from " << endd(ln.from) << " to " << endd(ln.to) << " segs " << C.spike_ranges.at(key).first << "-" << C.spike_ranges.at(key).second << " h";
+			const auto &sg = M.strands.at(ln.name).segs;
+			for (int i = C.spike_ranges.at(key).first; i <= C.spike_ranges.at(key).second; i++) {
+				const auto lit = g_spike_seg_line.find({ln.name, static_cast<uint32_t>(i)});
+				out << " " << sg[i].d << "@" << (lit == g_spike_seg_line.end() ? 0 : lit->second) << ":" << std::llround(Ev(val, sg[i].L));
+			}
+			out << " path";
+			for (PlanarHeading ph : spike_paths.paths[chs.channel_of_line[key.first]].headings) out << " " << static_cast<int>(ph);
+			out << "\n";
+		}
+	}
+	out << "jogs " << jogs << " heading changes in jogs " << jog_changes << " of " << all_changes << " cusps in stretches " << cusps << "\n";
+	out << "rough sum|b| " << rough_abs << "\n";
+
+	/* Tied corners: per crossing the rough x from every corner; consistency. */
+	std::map<int, std::vector<int>> rough_x; // vertex -> x implied by each corner
+	std::map<int, std::pair<int, int>> cross_lines;
+	for (const FaceData &F : fd) {
+		for (const auto &c : F.cross_at) {
+			rough_x[c.vertex].push_back(c.A ? c.v + 4 : -c.v);
+			cross_lines[c.vertex] = {c.la, c.lb};
+		}
+	}
+	int untied = 0, selfx = 0, outrange = 0;
+	for (const auto &[vx, xs] : rough_x) {
+		bool same = xs.size() == 4;
+		for (int x : xs) {
+			if (x != xs[0]) same = false;
+			if (x < 1 || x > 3) outrange++;
+		}
+		if (!same) untied++;
+		if (cross_lines[vx].first == cross_lines[vx].second) selfx++;
+	}
+	out << "crossings " << rough_x.size() << " rough not tied " << untied << " self-crossings " << selfx << " x out of [1,3] " << outrange << "\n";
+	/* The flow LPs. */
+	for (int variant = 0; variant < 2; variant++) {
+		JunctionMilp lp;
+		std::map<std::pair<uint32_t, uint32_t>, std::pair<uint32_t, uint32_t>> col;
+		for (const auto &[key, s] : str) {
+			const uint32_t p = lp.AddVariable(0, 8, 1, false);
+			const uint32_t n = lp.AddVariable(0, 8, 1, false);
+			col[key] = {p, n};
+		}
+		std::vector<uint32_t> wcols;
+		std::map<int, uint32_t> xcol;
+		for (size_t f = 0; f < faces.size(); f++) {
+			if (!fd[f].inner) continue;
+			std::map<uint32_t, double> terms;
+			int fixed = fd[f].fixed;
+			for (const Item &it : fd[f].items) {
+				if (it.line < 0) continue;
+				const auto &[p, n] = col.at({static_cast<uint32_t>(it.line), it.stretch});
+				const double c = it.forward ? 1 : -1;
+				terms[p] += c;
+				terms[n] -= c;
+			}
+			for (const auto &c : fd[f].cross_at) {
+				if (variant == 0) {
+					fixed += c.v;
+				} else {
+					auto it = xcol.find(c.vertex);
+					if (it == xcol.end()) {
+						const uint32_t w = lp.AddVariable(1, 3, 0, false);
+						wcols.push_back(w);
+						it = xcol.emplace(c.vertex, w).first;
+					}
+					if (c.A) {
+						terms[it->second] += 1;
+						fixed += -4;
+					} else {
+						terms[it->second] -= 1;
+					}
+				}
+			}
+			std::vector<std::pair<uint32_t, double>> row(terms.begin(), terms.end());
+			lp.AddRow(row, -8 - fixed, -8 - fixed);
+		}
+		const JunctionMilp::Status st = lp.Solve();
+		out << "LP" << variant + 1 << ": " << (st == JunctionMilp::Status::Optimal ? "optimal" : st == JunctionMilp::Status::Infeasible ? "INFEASIBLE" : "ERROR");
+		if (st != JunctionMilp::Status::Optimal) {
+			out << "\n";
+			continue;
+		}
+		bool integral = true;
+		for (uint32_t c = 0; c < col.size() * 2 + wcols.size(); c++) {
+			const double v = lp.Value(c);
+			if (std::abs(v - std::round(v)) > 1e-6) integral = false;
+		}
+		out << " integral " << (integral ? "yes" : "NO") << " objective " << lp.Objective() << " vs rough sum|b| " << rough_abs << "\n";
+		int differs = 0;
+		for (const auto &[key, s] : str) {
+			const double b = lp.Value(col.at(key).first) - lp.Value(col.at(key).second);
+			if (std::abs(b - s.b) > 1e-6) {
+				differs++;
+				out << "  " << t.lines[key.first].name << "#" << key.second << " rough " << s.b << " lp " << b << "\n";
+			}
+		}
+		out << "  stretches differing " << differs << "\n";
+		if (variant == 1) {
+			int xchg = 0;
+			for (const auto &[vx, w] : xcol) {
+				const int xr = rough_x[vx].empty() ? 0 : rough_x[vx][0];
+				const double xl = lp.Value(w);
+				if (std::abs(xl - xr) > 1e-6) {
+					xchg++;
+					out << "  crossing v" << vx << " " << t.lines[cross_lines[vx].first].name << "x" << t.lines[cross_lines[vx].second].name << " x rough " << xr << " lp " << xl << "\n";
+				}
+			}
+			out << "  crossings whose angle changes " << xchg << " of " << xcol.size() << "\n";
+		}
+	}
+	out << "ms " << std::chrono::duration_cast<std::chrono::milliseconds>(Clock::now() - t0).count() << "\n";
+}
