+/* Spike (hidden): any topology file through the mapped composer, dry or one variant. */
+TEST_CASE("planar: ll3 spike", "[.ll3]")
+{
+	const char *file = std::getenv("JUNCTION_TOPOLOGY_FILE");
+	REQUIRE(file != nullptr);
+	std::ifstream tin(file);
+	const std::string text((std::istreambuf_iterator<char>(tin)), std::istreambuf_iterator<char>());
+	PlanarSeed seed;
+	seed.text = text;
+	seed.topology = ParsePlanarTopology(text, &seed.why);
+	fmt::print(stderr, "PARSE why='{}' lines {} routes {}\n", seed.why, seed.topology.lines.size(), seed.topology.routes.size());
+	REQUIRE(seed.why.empty());
+	{
+		const PlanarChannels ch = BuildPlanarChannels(seed.topology);
+		const PlanarLineSides sides(seed.topology, ch);
+		fmt::print(stderr, "SIDES why='{}' channels {} crossings {}\n", sides.Why(), ch.channels.size(), ch.crossings.size());
+	}
+	const JunctionSpec spec = MakeTestJunctionSpec();
+	std::string why;
+	if (std::getenv("PLANAR_DRY") != nullptr || std::getenv("PLANAR_BITS") != nullptr) {
+		PlanarComponentLayout l;
+		SolvePlanarMapped(seed.topology, spec, l, &why);
+		fmt::print(stderr, "DRYEND why='{}'\n", why);
+		return;
+	}
+	const char *tag = std::getenv("LL3_TAG");
+	REQUIRE(tag != nullptr);
+	PlanarComponentLayout components;
+	const auto t0 = std::chrono::steady_clock::now();
+	const bool ok = SolvePlanarMappedVariant(seed.topology, spec, tag, nullptr, components, &why);
+	const long ms = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - t0).count();
+	fmt::print(stderr, "SOLVE tag {} ok {} ms {} why='{}'\n", tag, ok, ms, why);
+	if (!ok) return;
+	seed.components = std::move(components);
+	const PlanarPlan plan = PlanPlanarJunction(seed, spec, nullptr, {0, 0}, false);
+	fmt::print(stderr, "PLAN why='{}' layout {}\n", plan.why, plan.layout.has_value());
+	fmt::print(stderr, "SHAPE variant {} area {}\n", seed.components->variant, seed.components->area);
+	if (!plan.layout.has_value()) return;
+	fmt::print(stderr, "SIZE {}x{}\n", plan.layout->size.x, plan.layout->size.y);
+	std::map<int, int> by;
+	for (const RuleViolation &v : CheckJunctionRules(*plan.layout, spec, PlanarCheckerTopology(seed.topology))) {
+		by[static_cast<int>(v.rule)]++;
+		if (by[static_cast<int>(v.rule)] <= 2) fmt::print(stderr, "VIOLATION {} {} at {},{}\n", static_cast<int>(v.rule), v.message, v.tile.x, v.tile.y);
+	}
+	for (auto &[r, n] : by) fmt::print(stderr, "VCOUNT rule {} n {}\n", r, n);
+	fmt::print(stderr, "VTOTAL {}\n", by.size());
+}
