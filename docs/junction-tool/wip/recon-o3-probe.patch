+/* RECON-O3 probe: dumps one recorded seed as text lines (throwaway, never committed). */
+#ifndef PROBE_O3_H
+#define PROBE_O3_H
+
+#include <fstream>
+#include <map>
+#include <string>
+
+#include "../../junction/placement/junction_placement.h"
+#include "../../junction/topology/junction_topology.h"
+
+static void ProbeO3Dump(const std::string &path, const JunctionTrackGraph &graph, const JunctionTrackOrder &order, const JunctionTrackStructure &structure, const JunctionTrackPrograms &programs, const JunctionTrackArrangement &arr, const JunctionPlacementSystem &sys, const JunctionSystemPoint *use = nullptr)
+{
+	std::ofstream o(path);
+	const JunctionSystemPoint &pt = use != nullptr ? *use : sys.solved;
+	o << "SOLVED " << (pt.x.empty() ? 0 : 1) << " ptcount " << sys.pt_count << "\n";
+	for (size_t i = 0; i < pt.x.size(); i++) o << "PT " << i << " " << pt.x[i] << " " << pt.y[i] << "\n";
+	for (size_t i = 0; i < sys.item_pt.size(); i++) o << "ITEMPT " << i << " " << sys.item_pt[i] << " kind " << static_cast<int>(structure.stack[i].kind) << " row " << static_cast<int>(structure.stack[i].row) << "\n";
+	for (size_t n = 0; n < graph.nodes.size(); n++) o << "NODE " << n << " split " << graph.nodes[n].split << " slot " << graph.nodes[n].slot << " level " << order.node_level[n] << "\n";
+	for (size_t e = 0; e < graph.edges.size(); e++) {
+		const auto &g = graph.edges[e];
+		o << "EDGE " << e << " kind " << static_cast<int>(g.kind) << " from " << (g.from.node ? "n" : "p") << g.from.index << " to " << (g.to.node ? "n" : "p") << g.to.index << " paths";
+		for (auto p : g.paths) o << " " << p;
+		o << "\n";
+		o << "ENDS " << e << " start h" << static_cast<int>(programs.ends[e].first.heading) << " tok" << static_cast<int>(programs.ends[e].first.token == UINT32_MAX ? -1 : programs.ends[e].first.token) << " end h" << static_cast<int>(programs.ends[e].second.heading) << " tok" << static_cast<int>(programs.ends[e].second.token == UINT32_MAX ? -1 : programs.ends[e].second.token) << "\n";
+		for (int c = 0; c < 2; c++) {
+			const auto &prog = c == 0 ? programs.edges[e] : programs.copies[e];
+			for (size_t t = 0; t < prog.size(); t++) o << "PROG " << e << " " << c << " " << t << " kind " << static_cast<int>(prog[t].kind) << " hand " << static_cast<int>(prog[t].hand) << " index " << (prog[t].index == UINT32_MAX ? -1 : static_cast<int>(prog[t].index)) << " copy " << static_cast<int>(prog[t].copy) << " role " << static_cast<int>(prog[t].role) << "\n";
+		}
+	}
+	for (size_t r = 0; r < order.rows.size(); r++) {
+		o << "ROW " << r << ":";
+		for (const auto &it : order.rows[r]) o << " " << (it.node ? "n" : "e") << it.index;
+		o << "\n";
+	}
+	for (size_t b = 0; b < order.bands.size(); b++) {
+		for (size_t i = 0; i < order.bands[b].size(); i++) {
+			const auto &ev = order.bands[b][i];
+			o << "EVENT " << b << " " << i << " " << (ev.node ? "node" : "cross") << " " << ev.a << " " << ev.b << " layer " << ev.layer << "\n";
+		}
+		for (size_t i = 0; i < order.band_lines[b].size(); i++) {
+			o << "LINE " << b << " " << i << ":";
+			for (auto e : order.band_lines[b][i]) o << " " << e;
+			o << "\n";
+		}
+		for (size_t i = 0; i < arr.band_replacements[b].size(); i++) {
+			o << "REPL " << b << " " << i << " removed";
+			for (auto e : arr.band_replacements[b][i].removed) o << " " << e;
+			o << " inserted";
+			for (auto e : arr.band_replacements[b][i].inserted) o << " " << e;
+			o << "\n";
+		}
+	}
+	for (const auto &n : arr.band_neighbours) o << "NEIGH " << n.band << " " << n.west << " " << n.east << " ext " << n.extension_only << "\n";
+	for (const auto &n : arr.band_event_pairs) o << "EVPAIR " << n.band << " " << n.first << " " << n.second << "\n";
+	for (const auto &n : arr.band_pairs) o << "BANDPAIR " << n.band << " south " << n.south << " north " << n.north << "\n";
+	for (const auto &u : arr.unders) {
+		o << "UNDER edge " << u.edge << " tok " << u.token << " bridge " << u.bridge_edge << " copy " << static_cast<int>(u.copy) << " pieces";
+		for (auto p : u.pieces) o << " " << static_cast<int>(p);
+		o << "\n";
+	}
+	for (const auto &b : structure.bridges) {
+		o << "BRIDGE edge " << b.edge << " doubled " << b.doubled << " tunnel " << b.tunnel << " crossed";
+		for (auto c : b.crossed) o << " " << c;
+		o << "\n";
+	}
+	for (const auto &el : sys.chains) o << "ELEM e " << el.edge << " copy " << el.copy << " k " << el.k << " first " << el.first << " last " << el.last << " hin " << el.hin << " hout " << el.hout << " bend " << el.bend << "\n";
+	for (const auto &b : sys.bends) o << "BEND id " << b.id << " e " << b.edge << " copy " << b.copy << " tok " << b.tok << " kind " << b.kind << " src " << b.source << " hand " << b.hand << " hin " << b.hin << " first " << b.first << " last " << b.last << " m " << b.m << " floor " << b.floor << " group " << b.form_group << "\n";
+	for (const auto &g : sys.form_groups) o << "FORMGROUP e " << g.edge << " tok " << g.tok << " form " << g.form << "\n";
+	for (size_t i = 0; i < sys.clashes.size(); i++) o << "CLASH " << i << " gap " << sys.clashes[i].gap << " gaprev " << sys.clashes[i].gap_reversed << " tie " << sys.clashes[i].tie << " | " << sys.clashes[i].probe << "\n";
+	for (const auto &s : g_probe_occ) o << "OCC " << s << "\n";
+	auto col = [&](const JunctionSystemColumn &c) { return (c.pt >= 0 && !pt.x.empty() ? pt.x[c.pt] : 0) + c.c0 + (c.bend >= 0 ? c.c1 * sys.bends[c.bend].m : 0); };
+	for (size_t i = 0; i < sys.item_rows.size(); i++) {
+		for (const auto &oc : sys.item_rows[i]) o << "ITEMOCC " << i << " kind " << oc.kind << " edge " << (oc.edge == UINT32_MAX ? -1 : static_cast<int>(oc.edge)) << " copy " << oc.copy << " node " << (oc.node == UINT32_MAX ? -1 : static_cast<int>(oc.node)) << " west " << (col(oc.west) + (oc.ya >= 0 && !pt.y.empty() ? oc.cy * (pt.y[oc.ya] - pt.y[oc.yb]) : 0)) << " east " << (col(oc.east) + (oc.ya >= 0 && !pt.y.empty() ? oc.cy * (pt.y[oc.ya] - pt.y[oc.yb]) : 0)) << " rank " << oc.rank << " piece " << oc.piece << " bits " << static_cast<int>(oc.bits.base()) << "\n";
+	}
+	for (size_t i = 0; i < sys.crosser_pieces.size(); i++) {
+		const auto &c = sys.crosser_pieces[i];
+		o << "CPIECE " << i << " edge " << c.edge << " item " << c.item << " bend " << c.bend << " seg " << c.segment << " chosen " << c.chosen << "\n";
+	}
+	for (size_t i = 0; i < sys.fan_pairs.size(); i++) o << "FANPAIR " << i << " west " << sys.fan_pairs[i].west << " east " << sys.fan_pairs[i].east << " eastside " << sys.fan_pairs[i].east_side << " south " << sys.fan_pairs[i].south << "\n";
+	for (size_t i = 0; i < sys.fan_pieces.size(); i++) o << "FPIECE " << i << " pair " << sys.fan_pieces[i].pair << " end " << sys.fan_pieces[i].end << " edge " << sys.fan_pieces[i].edge << " kind " << sys.fan_pieces[i].kind << " chosen " << sys.fan_pieces[i].chosen << "\n";
+	int rows = 0;
+	std::map<std::string, int> by;
+	for (const auto &r : sys.static_rows) { by[r.reason.substr(0, 2)]++; rows++; }
+	o << "STATICROWS " << rows;
+	for (const auto &[k, v] : by) o << " " << k << "=" << v;
+	o << "\n";
+	o << "PORTROW";
+	for (int r : sys.port_row) o << " " << r;
+	o << " offset " << sys.port_offset << "\n";
+	{
+		std::map<std::string, int> rc;
+		for (const auto &r : sys.relations) {
+			const std::string key = std::string(r.axis != 0 ? "1 " : "0 ") + r.reason.substr(0, r.reason.find(" ("));
+			rc[key]++;
+			if (r.axis == 1) o << "YREL v " << r.v << " u " << r.u << " c " << r.c << " bend " << r.bend << " a " << r.a << " b " << r.b << " nl " << r.nonlinear << " zb " << r.zero_branch << " grp " << r.form_group << " alt " << r.alt << " over " << r.over << " reason " << r.reason.substr(0, r.reason.find(" (")) << "\n";
+			if (r.reason.find("clearance") != std::string::npos) o << "CLEAR axis " << static_cast<int>(r.axis) << " v " << r.v << " u " << r.u << " c " << r.c << " reason " << r.reason << "\n";
+		}
+		for (const auto &[k, v] : rc) o << "RELREASON " << k << " = " << v << "\n";
+	}
+	o << "RELATIONS " << sys.relations.size() << " CLASHES " << sys.clashes.size() << " OCCS " << g_probe_occ.size() << "\n";
+}
