+/** Probe (PLANAR_PRIOBRIDGE): whether the split at piece k (cur = pieces[k - 1]) goes into doubled copies of this lane: every other trackdir the lane could take there carries exactly the same (from_slot, to_slot) pairs as the path's own. */
+static bool IsCopySplit(const JunctionCheckContext &ctx, const JunctionPath &path, size_t k)
+{
+	const JunctionPiece &cur = path.pieces[k - 1];
+	const JunctionPiece &next = path.pieces[k];
+	std::map<Trackdir, std::set<std::pair<uint16_t, uint16_t>>> slots;
+	for (const JunctionPath &other : ctx.paths) {
+		for (const JunctionPiece &piece : other.pieces) {
+			if (piece.on_bridge || !SameTile(piece.tile, next.tile)) continue;
+			slots[piece.trackdir].emplace(other.from_slot, other.to_slot);
+		}
+	}
+	const TrackdirBits candidates = TrackdirReachesTrackdirs(cur.trackdir) & TrackdirsOf(TracksAt(ctx.layout, next.tile));
+	bool found_other = false;
+	for (Trackdir td : candidates) {
+		if (td == next.trackdir || !slots.contains(td)) continue;
+		found_other = true;
+		if (slots[td] != slots[next.trackdir]) return false;
+	}
+	return found_other;
+}
+
