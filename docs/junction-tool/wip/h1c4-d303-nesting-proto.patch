+
+TEST_CASE("bundle: a band bridge records one column per crossed track", "[junction][bundle]")
+{
+	JunctionSpec spec = MakeTestJunctionSpec();
+	BundleT t(2);
+	const JunctionTrackStructure structure = StructureJunctionTrackGraph(t.topology, t.paths, t.graph, t.order, &t.error);
+	REQUIRE(!structure.stack.empty());
+	const JunctionTrackPrograms programs = ProgramJunctionTrackGraph(t.topology, t.paths, t.graph, t.order, structure, &t.error);
+	REQUIRE(programs.nodes.size() == 6);
+	JunctionPlacementChoices choices;
+	for (const Program &program : programs.edges) {
+		choices.m.emplace_back(program.size(), 0);
+		choices.corner.emplace_back(program.size(), 0);
+	}
+	const JunctionPlacementSystem system = RecordJunctionPlacementSystem(t.topology, t.paths, t.graph, t.order, structure, programs, spec, choices);
+	REQUIRE(!system.overs.empty());
+
+	/* Each band bridge over a crossed edge of two tracks has an entry per track: strand 0 and 1 of the same (edge, tok), each over its own S-bend, the second sharing the first's alternative. */
+	std::map<std::pair<int, int>, std::vector<size_t>> by_bridge;
+	for (size_t i = 0; i < system.overs.size(); i++) by_bridge[{system.overs[i].edge, system.overs[i].tok}].push_back(i);
+	for (const auto &[bridge, entries] : by_bridge) {
+		INFO("edge " << bridge.first << " token " << bridge.second);
+		REQUIRE(entries.size() == 2);
+		const JunctionSystemOver &first = system.overs[entries[0]];
+		const JunctionSystemOver &second = system.overs[entries[1]];
+		CHECK(first.strand == 0);
+		CHECK(second.strand == 1);
+		CHECK(first.base == -1);
+		CHECK(second.base == static_cast<int>(entries[0]));
+		CHECK(first.bend != second.bend);
+	}
+}
