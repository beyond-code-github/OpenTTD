diff --git a/src/tests/junction/topology/junction_bundle.cpp b/src/tests/junction/topology/junction_bundle.cpp
index 92335da9ca..dfb5488794 100644
--- a/src/tests/junction/topology/junction_bundle.cpp
+++ b/src/tests/junction/topology/junction_bundle.cpp
@@ -569,3 +569,35 @@ TEST_CASE("bundle: dump the T with its block tiles", "[junction][bundle][.]")
 	for (const std::string &row : grid) text += row + "\n";
 	std::ofstream("/tmp/claude-1000/-home-pete-OpenTTD/021af430-3972-438e-9e4b-c282ea3899fd/scratchpad/h1a-t.txt") << text;
