+	/** Spike: two optional sideways steps in series on lanes (one binary per slot, shared by the lanes), diagonals of equal length. */
+	void FreeBend(const std::vector<std::string> &lanes, int h, const std::string &key, bool tail_h)
+	{
+		Model &M = this->M;
+		const int hi = FreeBendHi();
+		for (int slot = 0; slot < 2; slot++) {
+			const int sg = slot == 0 ? +1 : -1;
+			M.opt_group = key + (slot == 0 ? "A" : "B") + "j";
+			std::vector<Seg> ds;
+			for (const std::string &l : lanes) {
+				ds.push_back(M.AddSeg(l, Turn(h, sg), 2, hi, 1.0, true));
+				if (slot == 0 || tail_h) M.AddSeg(l, h, 0);
+			}
+			for (size_t j = 1; j < ds.size(); j++) M.Add(Eq(ds[j].L - ds[0].L, 0));
+		}
+		M.opt_group.clear();
+	}
