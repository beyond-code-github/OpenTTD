+namespace {
+
+constexpr int BOX_X0 = 335, BOX_Y0 = 311, BOX_X1 = 392, BOX_Y1 = 368;
+constexpr int BOX_W = BOX_X1 - BOX_X0 + 1, BOX_H = BOX_Y1 - BOX_Y0 + 1;
+
+std::string OutDir() { return "/tmp/claude-1000/-home-pete-OpenTTD/021af430-3972-438e-9e4b-c282ea3899fd/scratchpad/oracle227/"; }
+
+std::optional<Track> TrackOf(const std::string &s)
+{
+	if (s == "X") return Track::X;
+	if (s == "Y") return Track::Y;
+	if (s == "Upper") return Track::Upper;
+	if (s == "Lower") return Track::Lower;
+	if (s == "Left") return Track::Left;
+	if (s == "Right") return Track::Right;
+	return std::nullopt;
+}
+
+std::optional<Trackdir> TrackdirOf(const std::string &s)
+{
+	static const std::map<std::string, Trackdir> names = {
+		{"X_NE", Trackdir::X_NE}, {"Y_SE", Trackdir::Y_SE}, {"Upper_E", Trackdir::Upper_E}, {"Lower_E", Trackdir::Lower_E},
+		{"Left_S", Trackdir::Left_S}, {"Right_S", Trackdir::Right_S}, {"X_SW", Trackdir::X_SW}, {"Y_NW", Trackdir::Y_NW},
+		{"Upper_W", Trackdir::Upper_W}, {"Lower_W", Trackdir::Lower_W}, {"Left_N", Trackdir::Left_N}, {"Right_N", Trackdir::Right_N},
+	};
+	const auto it = names.find(s);
+	if (it == names.end()) return std::nullopt;
+	return it->second;
+}
+
+std::optional<SignalType> SignalTypeOf(const std::string &s)
+{
+	if (s == "block") return SignalType::Block;
+	if (s == "entry") return SignalType::Entry;
+	if (s == "exit") return SignalType::Exit;
+	if (s == "combo") return SignalType::Combo;
+	if (s == "path") return SignalType::Path;
+	if (s == "path_oneway") return SignalType::PathOneWay;
+	return std::nullopt;
+}
+
+bool InBoxMap(int x, int y) { return x >= BOX_X0 && x <= BOX_X1 && y >= BOX_Y0 && y <= BOX_Y1; }
+
+/** Offset in the unrotated box (the export's orientation) to the rotated layout offset and back: the same map. */
+TileIndexDiffC Off(int x, int y) { return {static_cast<int16_t>(x - BOX_X0), static_cast<int16_t>(y - BOX_Y0)}; }
+
+/** The rotated layout's offset to the map tile of the export. */
+std::pair<int, int> MapOf(TileIndexDiffC rotated)
+{
+	return {BOX_X0 + (BOX_W - 1 - rotated.x), BOX_Y0 + (BOX_H - 1 - rotated.y)};
+}
+
+struct Import {
+	JunctionLayout layout;
+	std::map<std::string, int> signals_by_type;
+	std::vector<std::string> skipped;
+	int tracks = 0, bridges = 0, tunnels = 0, stations = 0, two_way_tiles = 0;
+};
+
+Import ImportHub(const std::string &path)
+{
+	std::ifstream in(path);
+	REQUIRE(in.is_open());
+	const nlohmann::json json = nlohmann::json::parse(in);
+	Import imp;
+	JunctionLayout &layout = imp.layout;
+	layout.size = {BOX_W, BOX_H};
+	std::set<std::pair<std::pair<int, int>, std::pair<int, int>>> seen_bridges;
+	for (const nlohmann::json &tile : json["tiles"]) {
+		const int x = tile["x"], y = tile["y"];
+		if (!InBoxMap(x, y)) continue;
+		const std::string tile_type = tile["tile_type"];
+		if (tile_type == "station") { imp.stations++; continue; }
+		if (tile_type == "tunnelbridge") {
+			if (tile.value("transport", "") != "rail") continue;
+			const int fx = tile["far_end"]["x"], fy = tile["far_end"]["y"];
+			if (!InBoxMap(fx, fy)) { imp.skipped.push_back(fmt::format("bridge/tunnel head {},{} far end {},{} outside the box", x, y, fx, fy)); continue; }
+			const std::pair<int, int> a{x, y}, b{fx, fy};
+			if (!seen_bridges.insert({std::min(a, b), std::max(a, b)}).second) continue;
+			JunctionBridge bridge;
+			bridge.start = Off(std::min(a, b).first, std::min(a, b).second);
+			bridge.end = Off(std::max(a, b).first, std::max(a, b).second);
+			bridge.tunnel = tile["kind"] == "tunnel";
+			layout.bridges.push_back(bridge);
+			(bridge.tunnel ? imp.tunnels : imp.bridges)++;
+			continue;
+		}
+		if (tile_type != "rail") { imp.skipped.push_back(fmt::format("tile {},{} type {}", x, y, tile_type)); continue; }
+		TrackBits bits{};
+		for (const std::string name : tile["tracks"]) {
+			const auto track = TrackOf(name);
+			if (!track.has_value()) { imp.skipped.push_back(fmt::format("track {} at {},{}", name, x, y)); continue; }
+			bits.Set(*track);
+		}
+		layout.tracks.push_back({Off(x, y), bits});
+		imp.tracks++;
+		std::set<Trackdir> dirs;
+		for (const nlohmann::json &sig : tile["signals"]) {
+			const auto td = TrackdirOf(sig["trackdir"]);
+			const auto type = SignalTypeOf(sig["type"]);
+			if (!td.has_value() || !type.has_value() || sig["variant"] != "electric") {
+				imp.skipped.push_back(fmt::format("signal {} {} {} at {},{}", sig["type"].get<std::string>(), sig["variant"].get<std::string>(), sig["trackdir"].get<std::string>(), x, y));
+				continue;
+			}
+			layout.signals.push_back({Off(x, y), *td, *type, SignalVariant::Electric});
+			imp.signals_by_type[sig["type"]]++;
+			dirs.insert(*td);
+		}
+		/* Two-way: signals on one track facing both ways. */
+		for (Trackdir td : dirs) {
+			if (dirs.contains(ReverseTrackdir(td)) && td < ReverseTrackdir(td)) imp.two_way_tiles++;
+		}
+	}
+	/* The export's orientation (x to screen SW, y to SE) is the layout's; the N arm (NW edge) has no port side in the checker, so the hub is turned half a turn: the N arm lies on the S side, the E arm on W, the SW arm on E. */
+	imp.layout = TransformJunctionLayout(TransformJunctionLayout(layout, JunctionTransform::Rotate), JunctionTransform::Rotate);
+	return imp;
+}
+
+struct LaneName { std::string arm; int id; };
+
+/** The arm and lane id of a port of the rotated hub, as the trace names them. */
+std::string LaneId(const JunctionPort &port, JunctionSide side)
+{
+	const auto [mx, my] = MapOf(port.tile);
+	switch (side) {
+		case JunctionSide::W: return fmt::format("E{}", my);
+		case JunctionSide::S: return fmt::format("N{}", mx);
+		case JunctionSide::E: return fmt::format("SW{}", my);
+		default: return "?";
+	}
+}
+
+const std::vector<std::pair<std::string, std::vector<std::string>>> REACH = {
+	{"N354", {"E342", "SW362"}},
+	{"N355", {"E342", "E343", "SW362", "SW363"}},
+	{"E344", {"N353", "SW363"}},
+	{"E345", {"N350", "N353", "SW362", "SW363"}},
+	{"SW360", {"N350", "E343"}},
+	{"SW361", {"N350", "N353", "E342", "E343"}},
+};
+
+void WriteFamily(const std::string &name, const JunctionCheckContext &ctx, const std::vector<RuleViolation> &violations)
+{
+	std::ofstream file(OutDir() + name + ".txt");
+	file << fmt::format("{} {}\n", name, violations.size());
+	for (const RuleViolation &v : violations) {
+		const auto [mx, my] = MapOf(v.tile);
+		file << fmt::format("box {},{} map {},{} | {}\n", BOX_W - 1 - v.tile.x, BOX_H - 1 - v.tile.y, mx, my, v.message);
+	}
+	(void)ctx;
+}
+
+} // namespace
+
+TEST_CASE("oracle: the rule checker on PSG 227 BBH", "[.oracle]")
+{
+	const char *env = std::getenv("JUNCTION_ORACLE_JSON");
+	if (env == nullptr) { SUCCEED("JUNCTION_ORACLE_JSON unset"); return; }
+
+	const Import imp = ImportHub(env);
+	{
+		std::ofstream file(OutDir() + "import.txt");
+		file << fmt::format("tracks {} signals_total {} bridges {} tunnels {} stations {} two_way_pieces {}\n", imp.tracks, imp.layout.signals.size(), imp.bridges, imp.tunnels, imp.stations, imp.two_way_tiles);
+		for (const auto &[type, n] : imp.signals_by_type) file << fmt::format("signal {} {}\n", type, n);
+		for (const std::string &s : imp.skipped) file << "skipped " << s << "\n";
+	}
+	REQUIRE(imp.stations == 0);
+
+	JunctionLineSpec main_line{4, 1, 2};
+	const JunctionTopology topology = MakeJunctionHubTopology(main_line, main_line);
+	const JunctionSpec spec = MakeTestJunctionSpec();
+	const std::vector<JunctionPortSlot> slots = JunctionPortSlots(topology);
+	/* FindJunctionPorts wants one straight axis track per slot on a box edge; the N arm's lane N350 leaves on a curve, so the ports are built by hand from the trace's lanes. */
+	struct LanePort { const char *name; int x, y; Trackdir td; };
+	const std::vector<LanePort> lane_ports = {
+		{"E345", 392, 345, Trackdir::X_NE}, {"E344", 392, 344, Trackdir::X_NE}, {"E343", 392, 343, Trackdir::X_SW}, {"E342", 392, 342, Trackdir::X_SW},
+		{"N355", 355, 311, Trackdir::Y_SE}, {"N354", 354, 311, Trackdir::Y_SE}, {"N353", 353, 311, Trackdir::Y_NW}, {"N350", 350, 311, Trackdir::Left_N},
+		{"SW360", 335, 360, Trackdir::X_SW}, {"SW361", 335, 361, Trackdir::X_SW}, {"SW362", 335, 362, Trackdir::X_NE}, {"SW363", 335, 363, Trackdir::X_NE},
+	};
+	std::vector<JunctionPort> ports;
+	std::map<std::string, uint16_t> slot_of;
+	for (size_t i = 0; i < lane_ports.size(); i++) {
+		const LanePort &lp = lane_ports[i];
+		const Trackdir td = TransformTrackdir(TransformTrackdir(lp.td, JunctionTransform::Rotate), JunctionTransform::Rotate);
+		const TileIndexDiffC tile{static_cast<int16_t>(BOX_W - 1 - (lp.x - BOX_X0)), static_cast<int16_t>(BOX_H - 1 - (lp.y - BOX_Y0))};
+		ports.push_back({JunctionPortRole::EIn, tile, td, static_cast<uint16_t>(i)});
+		slot_of[lp.name] = static_cast<uint16_t>(i);
+		const bool in = topology.groups[slots[i].group].in;
+		INFO(lp.name);
+		CHECK(in == (std::string(lp.name) == "E345" || std::string(lp.name) == "E344" || std::string(lp.name) == "N355" || std::string(lp.name) == "N354" || std::string(lp.name) == "SW360" || std::string(lp.name) == "SW361"));
+	}
+	REQUIRE(ports.size() == slots.size());
+
+	std::vector<JunctionLanePath> lanes;
+	for (const auto &[from, outs] : REACH) {
+		for (const std::string &to : outs) {
+			const uint16_t f = slot_of.at(from), t = slot_of.at(to);
+			const auto movement = std::ranges::find(topology.movements, std::pair<uint8_t, uint8_t>{slots[f].group, slots[t].group});
+			REQUIRE(movement != topology.movements.end());
+			lanes.push_back({f, t, static_cast<uint16_t>(movement - topology.movements.begin())});
+		}
+	}
+
+	JunctionCheckContext ctx = MakeJunctionTopologyCheckContext(imp.layout, spec, topology, ports);
+	ctx.lanes = lanes;
+	for (JunctionPath &path : ctx.paths) {
+		const auto lane = std::ranges::find_if(lanes, [&](const JunctionLanePath &l) { return l.from == path.from_slot && l.to == path.to_slot; });
+		path.movement = lane == lanes.end() ? UINT16_MAX : lane->movement;
+	}
+	{
+		std::ofstream file(OutDir() + "paths.txt");
+		file << fmt::format("paths {} trace_problems {}\n", ctx.paths.size(), ctx.trace_problems.size());
+	}
+
+	using Check = std::vector<RuleViolation> (*)(const JunctionCheckContext &);
+	const std::vector<std::pair<std::string, Check>> families = {
+		{"Connectivity", CheckConnectivity}, {"Geometry", CheckGeometry}, {"Order", CheckOrder}, {"CurveSpeed", CheckCurveSpeed},
+		{"Bridges", CheckBridges}, {"Signals", CheckSignals}, {"WaitingRoom", CheckWaitingRoom}, {"Deadlock", CheckDeadlock},
+		{"Prio", CheckPrio}, {"Footprint", CheckFootprint}, {"PrioReach", CheckPrioReach},
+	};
+	for (const auto &[name, check] : families) {
+		DYNAMIC_SECTION(name) {
+			WriteFamily(name, ctx, check(ctx));
+			SUCCEED();
+		}
+	}
+}
