+	/* Q2: rows with row-chain pieces that are not item rows */
+	{
+		std::map<int, std::map<std::string, int>> nonitem;
+		for (const ProbeOcc &o : occ) if (!itemset.count(o.y) && o.kind.rfind("RE.", 0) == 0) nonitem[o.y][fmt::format("{} e{}", o.kind, o.edge)]++;
+		for (const auto &[y, m] : nonitem) { out << fmt::format("NONITEM row y {} holds row-edge pieces:", y); for (const auto &[k, v] : m) out << fmt::format(" {}x{}", k, v); out << "\n"; }
+		std::map<int, std::map<std::string, int>> nonitem_other;
