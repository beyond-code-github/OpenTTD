+		for (const auto &[y, m] : nonitem_other) { out << fmt::format("NONITEM row y {} holds other occupants:", y); for (const auto &[k, v] : m) out << fmt::format(" {}x{}", k, v); out << "\n"; }
+	}
+	/* hugs */
+	for (const ProbeHug &h : g_probe_hugs) out << fmt::format("hug edge {} row {} west flat {} east flat {} low {} high {} tiles {}\n", h.edge, h.row, h.flat_west, h.flat_east, h.lowv, h.highv, h.ntiles);
+	{ int pins = 0, hug = 0; for (const JunctionSystemRelation &r : system.relations) { if (r.reason.find("hug") == std::string::npos) continue; (r.order_pin ? pins : hug)++; } out << fmt::format("hug relations non-pin {} pin {}\n", hug, pins); }
+
+	/* relatedness as the occupancy */
+	auto at_node = [&](int edge, int node) { return edge >= 0 && ((graph.edges[edge].from.node && graph.edges[edge].from.index == static_cast<uint32_t>(node)) || (graph.edges[edge].to.node && graph.edges[edge].to.index == static_cast<uint32_t>(node))); };
