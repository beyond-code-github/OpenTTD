+		auto bridge_last = [&](size_t bi) { int v = -1; for (uint32_t x : bridges[bi]->crossed) v = std::max(v, crosser_pos(x)); return v; };
+		auto bridge_first = [&](size_t bi) { int v = INT_MAX; for (uint32_t x : bridges[bi]->crossed) v = std::min(v, crosser_pos(x)); return v; };
+		/* rank (travel position q) of an occupant, NOR when the rule does not rank it; item index for (a) */
