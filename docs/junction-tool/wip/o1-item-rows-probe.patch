+		std::vector<Info> info(row.size());
+		for (size_t k = 0; k < row.size(); k++) {
+			const ProbeOcc &o = row[k];
+			Info &f = info[k];
+			const int my_leg = static_cast<int>(leg_e[r]);
+			if (o.kind == "NodeTile") {
