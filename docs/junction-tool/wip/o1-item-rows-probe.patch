+static void ProbeSeed(const char *main, const char *branch, std::ostream &out)
+{
+	using Item = JunctionTrackRowItem;
+	const JunctionSpec spec = MakeTestJunctionSpec();
+	const JunctionTopology topology = ArrangementTopology(main, branch);
+	std::string error;
+	const JunctionGraphSeed seed = MakeJunctionGraphSeed(topology, spec, &error);
+	REQUIRE(!seed.routes.empty());
+	const JunctionTrackOrder order = OrderJunctionTrackGraph(topology, seed.paths, seed.graph, &error);
+	const JunctionTrackArrangement arrangement = ArrangeJunctionTrackGraph(seed.graph, order, seed.programs);
+	const JunctionTrackGraph &graph = seed.graph;
+	g_probe_occ.clear();
+	const JunctionPlacementSystem system = RecordJunctionPlacementSystem(topology, seed.paths, graph, order, seed.structure, seed.programs, spec, seed.placement.choices);
+	const std::vector<ProbeOcc> occ = g_probe_occ;
+	const std::vector<int> item_y = g_probe_item_y;
+	const size_t R = order.rows.size();
+	out << "=== HUB " << (main == nullptr ? "T" : main) << " x " << (main == nullptr ? "" : branch) << " ===\n";
+	auto nm = [](const Item &i) { return fmt::format("{}{}", i.node ? "n" : "e", i.index); };
+	/* row shape */
+	const auto slots = JunctionPortSlots(topology);
+	std::vector<bool> east(R, true);
+	std::vector<uint32_t> in_e(R, UINT32_MAX), leg_e(R, UINT32_MAX), out_e(R, UINT32_MAX);
+	for (uint32_t e = 0; e < graph.edges.size(); e++) {
+		const JunctionTrackEdge &ed = graph.edges[e];
+		if (JunctionIsInEdge(graph, order, seed.programs, e)) { const size_t r = (order.node_level[ed.to.index] - 1) / 2; in_e[r] = e; east[r] = topology.groups[slots[ed.from.index].group].side == JunctionSide::W; }
+		else if (JunctionIsOutEdge(graph, order, seed.programs, e)) out_e[(order.node_level[ed.from.index] - 1) / 2] = e;
+		else if (JunctionIsLegEdge(graph, order, e)) leg_e[(order.node_level[ed.from.index] - 1) / 2] = e;
+	}
+	for (size_t r = 0; r < R; r++) out << fmt::format("row {} east {} in e{} leg e{} out e{} items:", r, east[r] ? 1 : 0, in_e[r], leg_e[r], out_e[r]) << [&] { std::string s; for (const Item &i : order.rows[r]) s += " " + nm(i); return s; }() << "\n";
+	std::set<int> itemset(item_y.begin(), item_y.end());
