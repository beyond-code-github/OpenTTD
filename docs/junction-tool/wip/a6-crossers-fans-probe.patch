+/* PROBE A6 */
+struct ProbeFan { int item, y, edge, copy, lp, ldx, rp, rdx, bits; std::string kind, ptype; };
+extern std::vector<ProbeFan> g_probe_fans;
+
+namespace {
+struct A6Tile { int e, k, j, x, y; std::string type; };
+}
+
+static void ProbeA6Seed(const char *main, const char *branch, const char *name, std::ostream &out)
+{
+	static constexpr int VX[] = {0, 1, 0, -1};
+	static constexpr int VY[] = {-1, 0, 1, 0};
+	const ItemRowSeed seed = RecordItemRowSeed(main, branch);
+	const JunctionPlacementSystem &sys = seed.system;
+	const JunctionSystemPoint &sol = sys.solved;
+	const JunctionTrackGraph &graph = seed.seed.graph;
+	const std::vector<ProbeFan> fans = g_probe_fans;
+	out << "=== SEED " << name << " items " << sys.item_rows.size() << "\n";
+	auto val = [&](const JunctionSystemColumn &c) { return sol.x[c.pt] + c.c0 + (c.bend >= 0 ? c.c1 * sys.bends[c.bend].m : 0); };
+	const size_t items = sys.item_rows.size();
+	std::vector<int> item_y(items), item_row(items);
+	std::map<int, int> item_of_y;
+	for (size_t i = 0; i < items; i++) {
+		item_y[i] = sol.y[sys.item_pt[i]];
+		item_row[i] = seed.seed.structure.stack[i].row;
+		item_of_y[item_y[i]] = static_cast<int>(i);
+		out << "ITEM " << i << " y " << item_y[i] << " row " << item_row[i] << " kind " << static_cast<int>(seed.seed.structure.stack[i].kind) << "\n";
+	}
+	/* Per edge, its chain (copy 0 and 1) elements in order. */
+	std::map<std::pair<int, int>, std::vector<const JunctionSystemElement *>> chains;
+	for (const JunctionSystemElement &el : sys.chains) chains[{el.edge, el.copy}].push_back(&el);
+	auto present = [&](const JunctionSystemElement &el) { return el.bend < 0 || sys.bends[el.bend].m > 0; };
+	auto bend_forms = [&](const JunctionSystemElement &el) {
+		const JunctionSystemBend &b = sys.bends[el.bend];
+		return JunctionBendTileForms(b.hin, b.hand, b.m, b.kind == "Corner");
+	};
+	auto first_y = [&](const JunctionSystemElement &el) {
+		/* y of the element's first tile: a Fan's from the port row or the item row, else its point's row. */
+		if (el.k == "Fan") {
+			const JunctionSystemBend &b = sys.bends[el.bend];
+			const int y_item = sol.y[b.item_pt];
+			const int y_port = b.port_row;
+			/* port_first iff the edge starts on a port. */
+			const bool port_first = !graph.edges[el.edge].from.node;
+			return port_first ? y_port : y_item;
+		}
+		return sol.y[el.first];
+	};
+	/* All tiles of edge e at the solved point. */
+	auto edge_tiles = [&](int e, int copy) {
+		std::vector<A6Tile> tiles;
+		const auto &elems = chains[{e, copy}];
+		for (size_t k = 0; k < elems.size(); k++) {
+			const JunctionSystemElement &el = *elems[k];
+			if (!present(el)) continue;
+			if (el.k == "Tile") tiles.push_back({e, static_cast<int>(k), 0, sol.x[el.first], sol.y[el.first], "Tile"});
+			else if (el.k == "Heads" || el.k == "HeadsPair") { tiles.push_back({e, static_cast<int>(k), 0, sol.x[el.first], sol.y[el.first], "Head1"}); tiles.push_back({e, static_cast<int>(k), 1, sol.x[el.last], sol.y[el.last], "Head2"}); }
+			else if (el.bend >= 0) {
+				const JunctionSystemBend &b = sys.bends[el.bend];
+				const auto forms = bend_forms(el);
+				for (size_t j = 0; j < forms.size(); j++) {
+					const auto &f = forms[j];
+					tiles.push_back({e, static_cast<int>(k), static_cast<int>(j), sol.x[el.first] + f.dx0 + f.dx1 * b.m, first_y(el) + f.dy0 + f.dy1 * b.m, (f.tail ? "T" : "H") + std::string(b.kind)});
+				}
+			}
+			/* vertical run to the next present element */
+			size_t nk = k + 1;
+			while (nk < elems.size() && !present(*elems[nk])) nk++;
+			if (nk < elems.size() && elems[nk]->first != el.last && el.k != "Prio" && elems[nk]->k != "Prio" && (el.hout % 2) == 0) {
+				const int d = el.hout == 0 ? -1 : 1;
+				const int y0 = sol.y[el.last], y1 = sol.y[elems[nk]->first];
+				for (int y = y0 + d; d > 0 ? y < y1 : y > y1; y += d) tiles.push_back({e, static_cast<int>(k), -1, sol.x[el.last], y, "VRun"});
+			}
+		}
+		return tiles;
+	};
+	/* Crosser edges per row: items of order.rows that are edges. */
+	std::set<int> crossers;
+	std::map<int, std::set<int>> crossers_of_row;
+	for (size_t r = 0; r < seed.order.rows.size(); r++) for (const auto &it : seed.order.rows[r]) if (!it.node) { crossers.insert(it.index); crossers_of_row[static_cast<int>(r)].insert(it.index); }
+	/* Recorded crosser occupants per (item, edge). */
+	std::map<std::pair<int, int>, int> recorded_count;
+	for (size_t i = 0; i < items; i++) {
+		for (const JunctionItemRowOccupant &o : sys.item_rows[i]) {
+			if (o.kind != "crosser") continue;
+			recorded_count[{static_cast<int>(i), static_cast<int>(o.edge)}]++;
+			const int wv = val(o.west), ev = val(o.east);
+			std::string id = "?";
+			/* identify the element */
+			const auto &elems = chains[{static_cast<int>(o.edge), 0}];
+			for (int pass = 0; pass < 2; pass++) for (size_t k = 0; k < elems.size() && id == "?"; k++) {
+				const JunctionSystemElement &el = *elems[k];
+				if (!present(el)) continue;
+				if (pass == 0 && el.bend >= 0 && o.west.pt == el.first) {
+					const JunctionSystemBend &b = sys.bends[el.bend];
+					const auto forms = bend_forms(el);
+					for (size_t j = 0; j < forms.size(); j++) {
+						const auto &f = forms[j];
+						const int tx = sol.x[el.first] + f.dx0 + f.dx1 * b.m, ty = first_y(el) + f.dy0 + f.dy1 * b.m;
+						if (tx == wv && ty == item_y[i] && f.dx0 == o.west.c0 && (f.dx1 != 0 ? o.west.bend == el.bend : true)) {
+							const bool corner = b.kind == "Corner";
+							const JunctionSBendColumns cf = corner ? JunctionCornerColumnForm(b.hin, b.hand) : JunctionSBendColumnForm(b.hin, b.hand);
+							const int side = (b.hin + b.hand + 4) % 4;
+							const int t = f.dx0 * VX[side] + f.dy0 * VY[side] + (f.dx1 * VX[side] + f.dy1 * VY[side]) * b.m;
+							const int dy = ty - first_y(el);
+							const int TL = cf.t0 + cf.t1 * b.m;
+							const bool diag = (b.hin % 2 == 0) && t >= 1 && t <= TL && dy >= cf.lo + cf.s * (t - 1) && dy <= cf.hi + cf.s * (t - 1);
+							id = fmt::format("{} k{} bend{} tok{} hin{} hand{} L{} j{}/{} (dx{},dy{}) {} t{} T{} {} form(lo{} hi{} s{} t0 {} t1 {})", b.kind, k, el.bend, b.tok, b.hin, b.hand, b.m, j, forms.size(), tx - sol.x[el.first], dy, f.tail ? "tail" : "head", t, TL, diag ? "DIAG" : "END", cf.lo, cf.hi, cf.s, cf.t0, cf.t1);
+							break;
+						}
+					}
+				}
+				if (pass == 1 && id == "?" && el.k == "Tile" && o.west.pt == el.first) id = fmt::format("Tile k{}", k);
+				if (pass == 1 && id == "?" && (el.k == "Heads") && ((o.west.pt == el.first && sol.y[el.first] == item_y[i]) || (o.west.pt == el.last && sol.y[el.last] == item_y[i]))) id = fmt::format("Heads k{}", k);
+				if (pass == 1 && id == "?" && o.west.pt == el.last && o.west.c0 == 0 && o.west.c1 == 0) {
+					size_t nk = k + 1;
+					while (nk < elems.size() && !present(*elems[nk])) nk++;
+					const int y0 = sol.y[el.last];
+					const int y1 = nk < elems.size() ? sol.y[elems[nk]->first] : y0;
+					if ((y0 < item_y[i] && item_y[i] < y1) || (y1 < item_y[i] && item_y[i] < y0)) id = fmt::format("VRun after k{} ({} {}) prev bend {} next {} y0 {} y1 {}", k, el.k, el.bend, el.bend, nk < elems.size() ? elems[nk]->bend : -9, y0, y1);
+				}
+			}
+			out << fmt::format("CROSSER item {} y {} row {} edge {} west ({},{},{},b{}) = {} east = {} :: {}\n", i, item_y[i], item_row[i], o.edge, o.west.pt, o.west.c0, o.west.c1, o.west.bend, wv, ev, id);
+		}
+	}
+	/* Independent enumeration: every tile of every crosser on an item row of a row it crosses. */
+	int total = 0, missing = 0;
+	for (int e : crossers) {
+		for (size_t i = 0; i < items; i++) {
+			if (!crossers_of_row[item_row[i]].count(e)) continue;
+			std::vector<A6Tile> hits;
+			for (const A6Tile &t : edge_tiles(e, 0)) if (t.y == item_y[i]) hits.push_back(t);
+			total += static_cast<int>(hits.size());
+			const int rec = recorded_count.count({static_cast<int>(i), e}) ? recorded_count[{static_cast<int>(i), e}] : 0;
+			std::string tt;
+			for (const A6Tile &t : hits) tt += fmt::format(" [{} k{} j{} x{}]", t.type, t.k, t.j, t.x);
+			if (rec != static_cast<int>(hits.size())) missing += static_cast<int>(hits.size()) - rec;
+			out << fmt::format("COVER item {} y {} row {} crosser {} tiles {} recorded {}{}\n", i, item_y[i], item_row[i], e, hits.size(), rec, tt);
+		}
+	}
+	out << fmt::format("COVERTOTAL tiles {} not recorded {}\n", total, missing);
+	/* The closed affine forms against the recording (per crosser, item row: the tiles' columns). */
+	{
+		int pairs = 0, same = 0, ntiles = 0, same_tiles = 0;
+		std::map<std::string, std::pair<int, int>> by_kind; ///< cover kind -> (pairs, reproduced)
+		for (int e : crossers) {
+			const auto &elems = chains[{e, 0}];
+			for (size_t i = 0; i < items; i++) {
+				if (!crossers_of_row[item_row[i]].count(e)) continue;
+				const int y = item_y[i];
+				std::multiset<int> pred;
+				std::string kind;
+				for (size_t k = 0; k < elems.size(); k++) {
+					const JunctionSystemElement &el = *elems[k];
+					if (!present(el)) continue;
+					if (el.k == "Tile") { if (sol.y[el.first] == y) { pred.insert(sol.x[el.first]); kind += "Tile "; } }
+					else if (el.k == "Heads" || el.k == "HeadsPair") { for (int pt : {el.first, el.last}) if (sol.y[pt] == y) { pred.insert(sol.x[pt]); kind += "Heads "; } }
+					else if (el.bend >= 0) {
+						const JunctionSystemBend &b = sys.bends[el.bend];
+						const bool corner = b.kind == "Corner";
+						const int L = b.m, x0 = sol.x[el.first], y0 = first_y(el);
+						std::vector<int> xs;
+						if (b.hin % 2 == 0) {
+							const int d = b.hin == 2 ? 1 : -1, ee = ((b.hin + b.hand + 4) % 4) == 1 ? 1 : -1, r = d * (y - y0);
+							if (r >= 0 && r <= L - 1) xs = {x0 + ee * r, x0 + ee * r + ee};
+							else if (corner && r == L) xs = {x0 + ee * L};
+						} else {
+							const int c = b.hin == 1 ? 1 : -1, d = b.hin == 1 ? b.hand : -b.hand, r = d * (y - y0);
+							if (r == 0) xs = {x0};
+							else if (r >= 1 && r <= L - 1) xs = {x0 + c * (r - 1), x0 + c * r};
+							else if (r == L) xs = corner ? std::vector<int>{x0 + c * (L - 1), x0 + c * L} : std::vector<int>{x0 + c * (L - 1)};
+						}
+						if (!xs.empty()) kind += fmt::format("{}h{}{} ", b.kind, b.hin, b.hand > 0 ? "+" : "-");
+						for (int x : xs) pred.insert(x);
+					}
+					size_t nk = k + 1;
+					while (nk < elems.size() && !present(*elems[nk])) nk++;
+					if (nk < elems.size() && elems[nk]->first != el.last && el.k != "Prio" && elems[nk]->k != "Prio" && (el.hout % 2) == 0) {
+						const int y0 = sol.y[el.last], y1 = sol.y[elems[nk]->first];
+						if ((y0 < y && y < y1) || (y1 < y && y < y0)) { pred.insert(sol.x[el.last]); kind += "VRun "; }
+					}
+				}
+				std::multiset<int> rec;
+				for (const JunctionItemRowOccupant &o : sys.item_rows[i]) if (o.kind == "crosser" && static_cast<int>(o.edge) == e) rec.insert(val(o.west));
+				pairs++; ntiles += static_cast<int>(rec.size());
+				auto &bk = by_kind[kind]; bk.first++;
+				if (pred == rec) { same++; same_tiles += static_cast<int>(rec.size()); bk.second++; }
+				else { std::string a, b; for (int x : pred) a += fmt::format("{} ", x); for (int x : rec) b += fmt::format("{} ", x); out << fmt::format("FORMMISMATCH crosser {} item {} y {} predicted {} recorded {}\n", e, i, y, a, b); }
+			}
+		}
+		std::string bk;
+		for (const auto &[kd, v] : by_kind) bk += fmt::format(" [{}: {} pairs, {} reproduced]", kd, v.first, v.second);
+		out << fmt::format("FORMCHECK pairs {} reproduced {} tiles {} (reproduced pairs' tiles {}) by cover:{}\n", pairs, same, ntiles, same_tiles, bk);
+	}
+	/* Unders and head rows. */
+	for (const JunctionArrangementUnder &u : seed.arrangement.unders) {
+		/* head row of the bridge in u.bridge_edge copy u.copy that this crosser crosses. */
+		int ordinal = -1, n = 0;
+		for (const JunctionTrackBridge &b : seed.seed.structure.bridges) {
+			if (b.edge != u.bridge_edge) continue;
+			if (std::find(b.crossed.begin(), b.crossed.end(), u.edge) != b.crossed.end()) ordinal = n;
+			n++;
+		}
+		int hy = -1, hw = -1, he = -1, cnt = 0;
+		for (const JunctionSystemElement *el : chains[{static_cast<int>(u.bridge_edge), u.copy}]) {
+			if (el->k == "HeadsPair" && cnt++ == ordinal) { hy = sol.y[el->first]; hw = sol.x[el->first]; he = sol.x[el->last]; }
+		}
+		std::string pieces;
+		for (JunctionUnderPiece p : u.pieces) pieces += fmt::format("{}", static_cast<int>(p)) + ",";
+		/* nearest bend tokens */
+		int prev_tok = -1, next_tok = INT_MAX, prev_b = -1, next_b = -1;
+		for (const JunctionSystemBend &b : sys.bends) {
+			if (b.edge != static_cast<int>(u.edge) || b.copy != 0) continue;
+			if (b.tok < static_cast<int>(u.token) && b.tok > prev_tok) { prev_tok = b.tok; prev_b = b.id; }
+			if (b.tok > static_cast<int>(u.token) && b.tok < next_tok) { next_tok = b.tok; next_b = b.id; }
+		}
+		std::string cover;
+		for (const A6Tile &t : edge_tiles(u.edge, 0)) {
+			if (t.y != hy) continue;
+			const JunctionSystemElement *el = chains[{static_cast<int>(u.edge), 0}][t.k];
+			cover += fmt::format(" [{} bend{} x{}{}]", t.type, el->bend, t.x, (t.x > std::min(hw, he) && t.x < std::max(hw, he)) ? " BETWEEN" : " OUTSIDE");
+		}
+		out << fmt::format("UNDER crosser {} tok {} bridge_edge {} copy {} ordinal {} headrow {} (item {}) heads x {}..{} pieces {} prev_bend {} (tok {}) next_bend {} (tok {}) covers:{}\n", u.edge, u.token, u.bridge_edge, u.copy, ordinal, hy, item_of_y.count(hy) ? item_of_y[hy] : -1, hw, he, pieces, prev_b, prev_tok, next_b, next_tok == INT_MAX ? -1 : next_tok, cover);
+	}
+	for (const JunctionSystemBend &b : sys.bends) {
