+		out << fmt::format("CBEND id {} edge {} copy {} tok {} {} source {} hin {} hand {} m {} floor {} first y {} last y {} item_pt {} form_group {}\n", b.id, b.edge, b.copy, b.tok, b.kind, b.source, b.hin, b.hand, b.m, b.floor, sol.y[b.first], sol.y[b.last], b.item_pt, b.form_group);
+	}
+	/* The forms of every bend kind of a crosser edge in this seed. */
+	{
+		std::set<std::tuple<std::string, int, int>> seen;
+		for (const JunctionSystemBend &b : sys.bends) {
+			if (crossers.count(b.edge) == 0 || b.m <= 0) continue;
+			if (!seen.insert({b.kind, b.hin, b.hand}).second) continue;
+			const bool corner = b.kind == "Corner";
