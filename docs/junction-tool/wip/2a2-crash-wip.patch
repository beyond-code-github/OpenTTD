+TEST_CASE("joint: at every form with q fixed, the joint equals that form's recording", "[junction][milp]")
+{
+	const JunctionSpec spec = MakeTestJunctionSpec();
+	const LoopStart s = MakeLoopStart("L_R", "LL_RR", spec);
+	WARN("start: " << s.description);
+	/* The superset recording, at the S-bend form: both forms' rows. */
+	const JunctionPlacementSystem superset = RecordAt(s, spec, s.choices, nullptr);
+	REQUIRE(superset.form_groups.size() == 3);
+	const std::vector<std::pair<int, int>> crossings = CrossingsOf(s.programs);
+	REQUIRE(crossings.size() == superset.form_groups.size());
+	for (unsigned mask = 0; mask < (1u << superset.form_groups.size()); mask++) {
+		std::string form_string;
+		std::vector<int> forms;
+		for (size_t g = 0; g < superset.form_groups.size(); g++) {
+			forms.push_back(static_cast<int>((mask >> g) & 1));
+			form_string += forms.back() != 0 ? '1' : '0';
+		}
+		INFO("form " << form_string);
+		const JunctionJointResult from_superset = SolveJunctionJoint(superset, spec, false, &forms);
+
+		/* The form's own recording, its runs the ones the superset's joint chose; a form no rule allows records nothing. */
+		JunctionPlacementChoices choices = ChoicesWithForms(s, form_string, 0);
+		if (from_superset.status == JunctionMilp::Status::Optimal && !from_superset.choices.run.empty()) {
+			for (const JunctionSystemFormGroup &group : superset.form_groups) {
+				if (forms[&group - superset.form_groups.data()] != 0) choices.run[group.edge][group.tok] = from_superset.choices.run[group.edge][group.tok];
+			}
+		}
+		const JunctionPlacementSystem at_form = RecordAt(s, spec, choices, nullptr);
+		const bool recorded = !at_form.relations.empty() && at_form.failed.empty();
+		const JunctionJointResult from_form = recorded ? SolveJunctionJoint(at_form, spec, false, &forms) : JunctionJointResult{};
+		const bool optimal_form = recorded && from_form.status == JunctionMilp::Status::Optimal;
+		const bool optimal_superset = from_superset.status == JunctionMilp::Status::Optimal;
+		WARN(fmt::format("{}: recording {}, its joint {}, superset joint {}{}", form_string, recorded ? "ok" : "refused", optimal_form ? fmt::format("{:.2f}", FlatCost(from_form)) : "not optimal", optimal_superset ? fmt::format("{:.2f}", FlatCost(from_superset)) : "not optimal", ""));
+		if (!optimal_superset) { std::string c; for (const std::string &r : from_superset.conflict) c += r + " <- "; WARN("superset conflict: " << c); }
+		REQUIRE(optimal_form == optimal_superset);
+		if (optimal_form) CHECK(std::abs(FlatCost(from_form) - FlatCost(from_superset)) < 0.05);
+	}
+}
