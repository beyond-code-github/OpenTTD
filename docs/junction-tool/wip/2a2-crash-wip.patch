+	const JunctionSpec spec = MakeTestJunctionSpec();
+	for (const auto &[main, branch, objective] : {std::tuple{"L_R", "L_R", 27300.0}, std::tuple{"LL_RR", "L_R", 86350.0}}) {
+		INFO(main << " x " << branch);
+		const LoopStart s = MakeLoopStart(main, branch, spec);
