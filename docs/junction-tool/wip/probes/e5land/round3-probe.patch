+TEST_CASE("TEMP probe: one cell of 197", "[.][kaprobe]")
+{
+	std::string error;
+	const PlanarTopology topology = ParsePlanarTopology(ReadTopologyFileForDraw("psg197.txt"), &error);
+	const JunctionSpec spec = MakeTestJunctionSpec();
+	std::vector<std::string> report;
+	const PlanarStructureVariant structure = LoadPlanarStructureVariant(topology, ReadTopologyFileForDraw("psg197.structure.txt"), spec, report, &error);
+	PlanarShapeVariant shaped;
+	std::string why;
+	REQUIRE(ShapePlanarStructureVariant(structure, shaped, why));
+	const auto cells = PlanarShapeCellWalls(shaped);
+	for (const size_t c : {44, 45}) {
+		std::string text;
+		for (size_t k = 0; k < cells[c].size(); k++) {
+			const PlanarCellWall &w = cells[c][k];
+			if (w.track == PLANAR_DUMMY_TRACK) {
+				const PlanarShapeDummy &d = shaped.dummies[w.piece];
+				text += fmt::format(" [{}] dummy{} h{} (from {}.{} land {}.{})", k, w.piece, w.heading, shaped.structure.map.tracks[d.track].name, d.piece, d.land_track < shaped.structure.map.tracks.size() ? shaped.structure.map.tracks[d.land_track].name : "box/dummy", d.land_piece);
+			} else if (w.track == UINT32_MAX) {
+				text += fmt::format(" [{}] box{} h{}", k, w.piece, w.heading);
+			} else {
+				text += fmt::format(" [{}] {}.{} h{} (piece h{})", k, shaped.structure.map.tracks[w.track].name, w.piece, w.heading, shaped.tracks[w.track].pieces[w.piece]);
+			}
+		}
+		WARN("cell " << c << ":" << text);
+	}
