+/**
+ * The exit step of a one-lane merge onto a port line (DESIGN-pieces section 3 source 3).
+ * @param topology The topology.
+ * @param out_line The merge's out line, a port line.
+ * @param joiner_side Where the joiner arrives from: +1 right of travel, -1 left.
+ * @return The step toward the joiner's side when a ring neighbour of the out line on the same box side (any port, the line's own port included) lies there, else 0. An out line's predecessor lies left, its successor right.
+ */
+int8_t PlanarMergeExitStep(const PlanarTopology &topology, uint32_t out_line, int8_t joiner_side)
+{
+	const auto it = std::ranges::find(topology.ring, out_line);
+	if (it == topology.ring.end()) return 0;
+	const size_t i = static_cast<size_t>(it - topology.ring.begin());
+	const PlanarSide side = SideOfLine(topology, out_line);
+	const size_t neighbour = joiner_side < 0 ? i - 1 : i + 1; // wraps to a huge index for i == 0, which fails the bound test
+	if (neighbour >= topology.ring.size() || SideOfLine(topology, topology.ring[neighbour]) != side) return 0;
+	return joiner_side;
+}
