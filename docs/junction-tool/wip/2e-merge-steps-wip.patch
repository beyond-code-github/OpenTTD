+
+TEST_CASE("planar gaps: one-lane merge exit steps", "[junction][planargaps]")
+{
+	std::string error;
+	const PlanarTopology topology = ParsePlanarTopology(PlanarLL2Text(), &error);
+	REQUIRE(error.empty());
+	const auto step = [&](std::string_view line, int8_t side) {
+		return PlanarMergeExitStep(topology, PlanarLineByName(topology, line), side);
+	};
+
+	/* E side, north to south on the ring: EO1, EO2, AB2, AB1. An out line's predecessor lies left of its travel, its successor right. */
+	CHECK(step("EO1", +1) == +1); // EO2 lies right of EO1
+	CHECK(step("EO1", -1) == 0); // nothing north of EO1 on the E side
+	CHECK(step("EO2", -1) == -1); // EO1 lies left of EO2
+	CHECK(step("EO2", +1) == +1); // the next lane on the ring (AB2's line) lies right of EO2
+
+	/* W side, south to north on the ring: WO1, WO2, EF2, EF1; WO1 has no predecessor on its side (the ring before it is the S side). */
+	CHECK(step("WO1", +1) == +1); // WO2 lies right of WO1
+	CHECK(step("WO1", -1) == 0);
+	/* S side, east to west on the ring: SO1, SO2, CD2, CD1; SO2 has SO1 before it and CD2 after it. */
+	CHECK(step("SO2", -1) == -1);
+	CHECK(step("SO2", +1) == +1);
+}
