+			const std::optional<Choice> &ch = get(i);
+			total += ch.has_value() ? ch->cost : BIG;
+			if (!ch.has_value()) continue;
+			const Tile &t = order_tiles[i];
+			if (g_joint_stats.block_penalty && ch->moves) {
