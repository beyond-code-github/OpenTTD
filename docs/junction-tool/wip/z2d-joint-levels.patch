+		std::map<size_t, std::optional<Choice>> memo;
+		auto get = [&](size_t i) -> const std::optional<Choice> & {
+			auto it = memo.find(i);
+			if (it == memo.end()) it = memo.emplace(i, demand(i, lv)).first;
+			return it->second;
+		};
