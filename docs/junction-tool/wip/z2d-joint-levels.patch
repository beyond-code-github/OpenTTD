+						for (int oy = -1; oy <= 0; oy++) {
+							const JunctionTerrainTile *nt = c.terrain.At(cx + ox, cy + oy);
+							if (nt == nullptr || nt->cls != JunctionTileClass::Buildable) total += BIG;
+						}
+					}
+				}
+			}
+			for (int dx = -1; dx <= 1; dx++) {
+				for (int dy = -1; dy <= 1; dy++) {
+					if (dx == 0 && dy == 0) continue;
+					const auto f = var.find({t.first + dx, t.second + dy});
+					if (f == var.end()) continue;
+					const size_t j = f->second;
+					if (affected.contains(j) && j < i) continue;
