+	{ const int keep = g_joint_stats.conflict_weight; const bool bp = g_joint_stats.block_penalty; g_joint_stats = {}; g_joint_stats.conflict_weight = keep; g_joint_stats.block_penalty = bp; }
+	std::map<Tile, JTile> tiles;
