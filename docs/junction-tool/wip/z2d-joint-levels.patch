+		tiles[visits.back().tile].rampable = false;
+	}
+	/* Variables. */
+	std::vector<Tile> order_tiles;
+	std::map<Tile, size_t> var;
+	int lowest = INT_MAX, highest = INT_MIN;
+	for (auto &[tile, jt] : tiles) {
+		const JunctionTerrainTile *g = c.terrain.At(tile.first, tile.second);
+		lowest = std::min<int>(lowest, g->z_min);
+		highest = std::max<int>(highest, g->z_max);
+	}
+	if (tiles.empty()) return "";
+	const int base = lowest - 3;
+	const int top = highest + 3;
+	for (auto &[tile, jt] : tiles) {
+		var[tile] = order_tiles.size();
+		order_tiles.push_back(tile);
+	}
+	const size_t n = order_tiles.size();
+	JunctionPositions pos(n, 0, top - base);
+	std::vector<std::string> reasons;
+	auto reason = [&](const std::string &text) { reasons.push_back(text); return static_cast<uint32_t>(reasons.size() - 1); };
