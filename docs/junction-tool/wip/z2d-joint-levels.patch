+/** One tile of the joint solve. */
+struct JTile {
+	Visit visit;
+	bool rampable = false; ///< Lone axis track, all routes the same way, not a node, port or head.
+	bool has_next = false;
+	Tile next;
+	std::vector<Tile> preds; ///< Tiles whose route goes on to this one and are rampable.
