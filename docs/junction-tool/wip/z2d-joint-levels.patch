+			const auto [slot, fresh] = tiles.try_emplace(v.tile);
+			if (fresh) slot->second.visit = v;
+			dirs[v.tile].insert(v.dir);
+			auto [it, ins] = all_axis.emplace(v.tile, v.axis);
+			if (!ins) it->second = it->second && v.axis;
+		}
+	}
+	for (auto &[tile, jt] : tiles) {
