+std::string JointLevels(const Context &c, const std::vector<std::vector<Visit>> &route_visits, const std::set<Tile> &heads, const std::set<Tile> &fixed_tiles, const JunctionLayout &layout, TileIndexDiffC offset, int ramp_levels, int train_length, JointResult &out)
