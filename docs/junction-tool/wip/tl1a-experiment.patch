+/* TL1a diag (scratch, reverted). */
+static std::string TlGapReport(const JunctionLayout &layout, const JunctionSpec &spec, const JunctionTopology &t);
+extern int g_tl_fix;
+static std::vector<JunctionTrackRoute> g_tl_routes;
+static JunctionTrackPrograms g_tl_programs;
+static JunctionTrackGraph g_tl_graph;
+static std::string TlRouteReport(const JunctionSpec &spec);
+static JunctionLayout TlRender(const JunctionTopology &t, const JunctionSpec &spec, std::string *error, JunctionTrackPlacement *pl, std::vector<JunctionTrackSignal> *tokens)
+{
+	std::string ignored;
+	const std::vector<JunctionLanePath> paths = ExpandJunctionLanes(t, &ignored);
+	const JunctionTrackGraph graph = BuildJunctionTrackGraph(t, paths, &ignored);
+	const JunctionTrackOrder order = OrderJunctionTrackGraph(t, paths, graph, &ignored);
+	const JunctionTrackStructure structure = StructureJunctionTrackGraph(t, paths, graph, order, &ignored);
+	const JunctionTrackPrograms programs = ProgramJunctionTrackGraph(t, paths, graph, order, structure, &ignored);
+	std::vector<JunctionTrackRoute> routes;
+	const JunctionTrackStructure cut = CutJunctionTrackBridges(t, paths, graph, order, structure, programs, spec, pl, error);
+	if (pl->nodes.empty()) return {};
+	JunctionLayout layout = RenderJunctionTrackPlacement(t, paths, graph, cut, programs, *pl, error, &routes);
+	*tokens = SignalJunctionTrackRoutes(layout, routes, t, paths, graph, programs, spec);
+	g_tl_routes = routes; g_tl_programs = programs; g_tl_graph = graph;
+	return layout;
+}
