+/** Per path: the curves, and every JunctionCurveGaps pair that fails, for any topology. */
+static std::string TlGapReport(const JunctionLayout &layout, const JunctionSpec &spec, const JunctionTopology &t)
+{
+	const JunctionCheckContext ctx = MakeJunctionTopologyCheckContext(layout, spec, t, FindJunctionPorts(layout, t));
+	std::string out;
+	for (size_t pi = 0; pi < ctx.paths.size(); pi++) {
+		const JunctionPath &path = ctx.paths[pi];
+		std::vector<JunctionCurveHand> hands;
+		std::vector<int> pos;
+		std::vector<TileIndexDiffC> tiles;
+		std::string cs;
+		unsigned unit = 0;
+		for (size_t i = 0; i < path.pieces.size(); i++) {
+			if (i > 0) {
+				const DirDiff diff = DirDifference(TrackdirToDirection(path.pieces[i - 1].trackdir), TrackdirToDirection(path.pieces[i].trackdir));
+				if (diff == DirDiff::Left45 || diff == DirDiff::Right45) {
+					hands.push_back(diff == DirDiff::Left45 ? JunctionCurveHand::Left : JunctionCurveHand::Right);
+					pos.push_back(unit);
+					tiles.push_back(path.pieces[i].tile);
+					cs += fmt::format(" {}{}@{},{}", unit, diff == DirDiff::Left45 ? 'L' : 'R', path.pieces[i].tile.x, path.pieces[i].tile.y);
+				}
+			}
+			unit += path.pieces[i].units;
+		}
+		const int limit = JunctionMinCurveSpeed(path.pieces, spec.tl, spec.curve_speed);
+		std::string bad;
+		for (const JunctionCurveGap &g : JunctionCurveGaps(hands, spec.tl, spec.curve_speed, spec.reference_speed)) {
+			const int actual = pos[g.j] - pos[g.i];
+			if (actual < g.min_gap) bad += fmt::format(" [c{}-c{} ({}{} {}{}) gap {} < {}]", g.i, g.j, pos[g.i], hands[g.i] == JunctionCurveHand::Left ? 'L' : 'R', pos[g.j], hands[g.j] == JunctionCurveHand::Left ? 'L' : 'R', actual, g.min_gap);
+		}
+		if (limit < spec.reference_speed || !bad.empty()) out += fmt::format("path {} slots {}->{} units {} minspeed {}{} curves{}\n   gapfail{}\n", pi, path.from_slot, path.to_slot, unit, limit, limit < spec.reference_speed ? " LOW" : "", cs, bad.empty() ? " none" : bad);
+	}
+	return out;
+}
+
+static std::string TlRouteReport(const JunctionSpec &spec)
+{
+	std::string out;
+	static constexpr const char *KIND[] = {"Fan", "Corner", "SBend", "Over", "Under"};
+	for (size_t ri = 0; ri < g_tl_routes.size(); ri++) {
+		const JunctionTrackRoute &r = g_tl_routes[ri];
+		std::vector<JunctionCurveHand> hands;
+		std::vector<int> pos;
+		std::vector<std::string> tag;
+		unsigned unit = 0;
+		for (size_t i = 0; i < r.pieces.size(); i++) {
+			if (i > 0) {
+				const DirDiff diff = DirDifference(TrackdirToDirection(r.pieces[i - 1].trackdir), TrackdirToDirection(r.pieces[i].trackdir));
+				if (diff == DirDiff::Left45 || diff == DirDiff::Right45) {
+					hands.push_back(diff == DirDiff::Left45 ? JunctionCurveHand::Left : JunctionCurveHand::Right);
+					pos.push_back(unit);
+					std::string tg;
+					for (size_t q = i - 1; q <= i; q++) {
+						const JunctionTrackPieceTag &g = r.tags[q];
+						const JunctionTrackEdge &ed = g_tl_graph.edges[g.edge];
+						tg += fmt::format("e{}{}", g.edge, ed.kind == JunctionTrackEdge::Kind::In ? "in" : ed.kind == JunctionTrackEdge::Kind::Out ? "out" : "leg");
+						if (g.token != JunctionTrackPieceTag::RUN) {
+							const auto &prog = g.copy ? g_tl_programs.copies[g.edge] : g_tl_programs.edges[g.edge];
+							tg += fmt::format(":{}{}", KIND[static_cast<int>(prog[g.token].kind)], g.copy ? "c1" : "");
+						} else {
+							tg += fmt::format(":run{}", g.run);
+						}
+						if (q + 1 == i + 1) break;
+						tg += ">";
+					}
+					tag.push_back(tg);
+				}
+			}
+			unit += r.pieces[i].units;
+		}
+		const int limit = JunctionMinCurveSpeed(r.pieces, spec.tl, spec.curve_speed);
+		std::string bad;
+		for (const JunctionCurveGap &g : JunctionCurveGaps(hands, spec.tl, spec.curve_speed, spec.reference_speed)) {
+			const int actual = pos[g.j] - pos[g.i];
+			if (actual < g.min_gap) bad += fmt::format(" [c{}-c{} {}{}@{} {} {}{}@{} {} gap {} < {}]", g.i, g.j, hands[g.i] == JunctionCurveHand::Left ? 'L' : 'R', "", pos[g.i], tag[g.i], hands[g.j] == JunctionCurveHand::Left ? 'L' : 'R', "", pos[g.j], tag[g.j], actual, g.min_gap);
+		}
+		if (limit < spec.reference_speed || !bad.empty()) out += fmt::format("route {} path {} copy {} units {} minspeed {}{}\n   {}\n", ri, r.path, r.copy, unit, limit, limit < spec.reference_speed ? " LOW" : "", bad.empty() ? "no gap fail" : bad);
+	}
+	return out;
+}
