+/* SCRATCH ST1a: unrelated edges sharing or touching a tile. */
+static std::set<std::tuple<int, int, int, int, int>> OccupancyOf(const std::vector<JunctionTrackRoute> &routes, const JunctionTrackGraph &graph)
+{
+	struct P { int x, y, e, side0, side1; bool bridge; };
+	std::set<std::tuple<int, int, int, int, int, int>> seen;
+	std::vector<P> ps;
+	for (const JunctionTrackRoute &r : routes) {
+		for (size_t i = 0; i < r.pieces.size(); i++) {
+			const JunctionPiece &pc = r.pieces[i];
+			const int ex = static_cast<int>(TrackdirToExitdir(pc.trackdir));
+			const int en = static_cast<int>(TrackdirToExitdir(ReverseTrackdir(pc.trackdir)));
+			if (!seen.insert({pc.tile.x, pc.tile.y, (int)r.tags[i].edge, ex, en, pc.on_bridge}).second) continue;
+			ps.push_back({pc.tile.x, pc.tile.y, (int)r.tags[i].edge, en, ex, pc.on_bridge});
+		}
+	}
+	auto related = [&](int a, int b) {
+		if (a == b) return true;
+		const auto &A = graph.edges[a], &B = graph.edges[b];
+		auto nodes = [](const JunctionTrackEdge &e) { std::vector<int> v; if (e.from.node) v.push_back(e.from.index); if (e.to.node) v.push_back(e.to.index); return v; };
+		for (int na : nodes(A)) for (int nb : nodes(B)) if (na == nb) return true;
+		return false;
+	};
+	std::set<std::tuple<int, int, int, int, int>> res; // kind(0 share,1 touch), edge a, edge b, x, y
+	static const int DX[4] = {-1, 0, 1, 0}, DY[4] = {0, 1, 0, -1};
+	for (size_t i = 0; i < ps.size(); i++) {
+		for (size_t j = i + 1; j < ps.size(); j++) {
+			if (ps[i].e == ps[j].e || related(ps[i].e, ps[j].e)) continue;
+			const int a = std::min(ps[i].e, ps[j].e), b = std::max(ps[i].e, ps[j].e);
+			if (ps[i].x == ps[j].x && ps[i].y == ps[j].y && !ps[i].bridge && !ps[j].bridge) res.insert({0, a, b, ps[i].x, ps[i].y});
+			if (ps[i].bridge || ps[j].bridge) continue;
+			for (int d : {ps[i].side0, ps[i].side1}) {
+				if (ps[i].x + DX[d] == ps[j].x && ps[i].y + DY[d] == ps[j].y) {
+					const int rd = (d + 2) & 3;
+					if (ps[j].side0 == rd || ps[j].side1 == rd) res.insert({1, a, b, ps[i].x, ps[i].y});
+				}
+			}
+		}
+	}
+	return res;
+}
