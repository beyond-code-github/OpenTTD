+	auto t0 = std::chrono::steady_clock::now();
+	struct Cell { const char *name; int tl; int v; bool sized; };
+	const Cell cells[] = {{"test", 0, 0, false}, {"tl3v100", 3, 100, true}, {"tl6v196", 6, 196, true}};
+	long total_runs = 0, total_fail = 0;
+	for (int ti = 0; ti < 2; ti++) {
+		const JunctionTopology &t = ti == 0 ? JunctionTTopology() : JunctionLLRRSidelineTopology();
+		const char *tn = ti == 0 ? "T" : "LL_RR";
+		for (const Cell &cell : cells) {
+			JunctionSpec spec = MakeTestJunctionSpec();
+			if (cell.sized) {
+				spec.tl = cell.tl; spec.train.max_speed = cell.v; spec.reference_speed = cell.v;
+				spec.prio_tiles = 0;
+				spec.prio_tiles = SizeJunctionPrio(spec).prio_tiles;
+			}
+			std::string ign;
+			const std::vector<JunctionLanePath> paths = ExpandJunctionLanes(t, &ign);
+			const JunctionTrackGraph graph = BuildJunctionTrackGraph(t, paths, &ign);
+			const JunctionTrackOrder order = OrderJunctionTrackGraph(t, paths, graph, &ign);
+			const JunctionTrackStructure structure = StructureJunctionTrackGraph(t, paths, graph, order, &ign);
+			const JunctionTrackPrograms programs = ProgramJunctionTrackGraph(t, paths, graph, order, structure, &ign);
+			JunctionTrackPlacement p, p0;
+			g_stretch.mode = 0;
+			g_stretch.props = 0;
+			CutJunctionTrackBridges(t, paths, graph, order, structure, programs, spec, &p0, &ign);
+			g_stretch.props = props;
+			const JunctionTrackStructure cut = CutJunctionTrackBridges(t, paths, graph, order, structure, programs, spec, &p, &ign);
+			REQUIRE(!p.nodes.empty());
+			sum << "== " << tn << " " << cell.name << " seed identical to props-0 seed: " << (SamePlacement(p0, p) ? "yes" : "NO") << "\n";
+
+			/* Bridge measure helper: per bridge, per copy: head range and crossers' range on the head line. */
+			auto bridge_measure = [&](const JunctionTrackPlacement &q, const std::vector<JunctionTrackRoute> &routes) {
+				std::string s;
+				for (size_t b = 0; b < cut.bridges.size(); b++) {
+					for (int c = 0; c < 2; c++) {
+						const JunctionBridge &h = q.bridges[b][c];
+						if (h.start.x == 0 && h.start.y == 0 && h.end.x == 0 && h.end.y == 0) continue;
+						const bool row = h.start.y == h.end.y;
+						const int line = row ? h.start.y : h.start.x;
+						const int hlo = row ? std::min(h.start.x, h.end.x) : std::min(h.start.y, h.end.y);
+						const int hhi = row ? std::max(h.start.x, h.end.x) : std::max(h.start.y, h.end.y);
+						std::map<uint32_t, std::pair<int, int>> per;
+						for (const JunctionTrackRoute &r : routes) {
+							for (size_t i = 0; i < r.pieces.size(); i++) {
+								const uint32_t e = r.tags[i].edge;
+								if (std::find(cut.bridges[b].crossed.begin(), cut.bridges[b].crossed.end(), e) == cut.bridges[b].crossed.end()) continue;
+								const TileIndexDiffC tl = r.pieces[i].tile;
+								if ((row ? tl.y : tl.x) != line) continue;
+								const int pos = row ? tl.x : tl.y;
+								auto it = per.find(e);
+								if (it == per.end()) per[e] = {pos, pos}; else { it->second.first = std::min(it->second.first, pos); it->second.second = std::max(it->second.second, pos); }
+							}
+						}
+						int clo = INT_MAX, chi = INT_MIN;
+						std::string sp;
+						std::vector<std::pair<int, int>> rng;
+						for (auto &[e, r] : per) { clo = std::min(clo, r.first); chi = std::max(chi, r.second); rng.push_back(r); sp += fmt::format(" e{}[{},{}]", e, r.first, r.second); }
+						s += fmt::format("B{}c{} line{} heads[{},{}] crossers[{},{}] lo-gap {} hi-gap {} span {}{}\n", b, c, line, hlo, hhi, clo, chi, clo - hlo, hhi - chi, hhi - hlo, sp);
+					}
+				}
+				return s;
+			};
+
+			std::set<std::tuple<int, int, int>> base_occ;
+			/* Seed render for the baseline. */
+			{
+				std::string e1;
+				std::vector<JunctionTrackRoute> routes;
+				JunctionLayout lay = RenderJunctionTrackPlacement(t, paths, graph, cut, programs, p, &e1, &routes);
+				std::vector<JunctionTrackSignal> toks = SignalJunctionTrackRoutes(lay, routes, t, paths, graph, programs, spec);
+				const auto viol = CheckJunctionRules(lay, spec, t);
+				sum << "== " << tn << " " << cell.name << " seed: box " << p.size.x << "x" << p.size.y << " render '" << e1 << "' tokens " << toks.size() << " violations " << viol.size() << "\n";
+				sum << "hug choices:"; for (auto &h : p.choices.hug) sum << " [" << h[0] << "," << h[1] << "," << h[2] << "," << h[3] << "]"; sum << "\n";
+				sum << bridge_measure(p, routes);
+				for (auto &o : OccupancyOf(routes, graph)) base_occ.insert({std::get<0>(o), std::get<1>(o), std::get<2>(o)});
+				sum << "baseline unrelated share/touch pairs:"; for (auto &o : base_occ) sum << " (" << std::get<0>(o) << ",e" << std::get<1>(o) << ",e" << std::get<2>(o) << ")"; sum << "\n";
+			}
+
+			/* Count. */
+			g_stretch.mode = 1;
+			{
+				std::string e2;
+				const JunctionTrackPlacement q = PlaceJunctionTrackGraph(t, paths, graph, order, cut, programs, spec, p.choices, &e2);
+				REQUIRE(!q.nodes.empty());
+			}
+			const int nx = g_stretch.count[0], ny = g_stretch.count[1];
+			sum << "relations lower-bound-only: X " << nx << " Y " << ny << "\n";
+			long runs = 0, fails = 0, same = 0;
+			for (int axis = 0; axis < 2; axis++) {
+				const int n = axis == 0 ? nx : ny;
+				for (int idx = 0; idx < n; idx++) {
+					for (int s : {1, 2, 5}) {
+						g_stretch.mode = 2; g_stretch.axis = axis; g_stretch.index = idx; g_stretch.s = s; g_stretch.applied = false;
+						runs++;
+						std::string err;
+						const JunctionTrackPlacement q = PlaceJunctionTrackGraph(t, paths, graph, order, cut, programs, spec, p.choices, &err);
+						const JunctionPlacementReason rr = g_stretch.reason;
+						g_stretch.mode = 0;
+						auto rs = [&]() { return fmt::format("{}/e{}/n{}/r{}", rr.rule == nullptr ? "?" : rr.rule, (int)rr.edge, (int)rr.node, rr.row); };
+						std::string head = fmt::format("{}\t{}\t{}\t{}\t{}\t{}\t", tn, cell.name, axis == 0 ? "X" : "Y", idx, s, rs());
+						if (q.nodes.empty()) {
+							fails++;
+							out << head << "SOLVE\t-\t-\t" << err.substr(0, 200) << "\n";
+							continue;
+						}
+						if (SamePlacement(p, q)) same++;
+						std::string e1;
+						std::vector<JunctionTrackRoute> routes;
+						JunctionLayout lay = RenderJunctionTrackPlacement(t, paths, graph, cut, programs, q, &e1, &routes);
+						if (lay.tracks.empty()) {
+							fails++;
+							out << head << "RENDER\t-\t-\t" << e1.substr(0, 200) << "\n";
+							continue;
+						}
+						std::vector<JunctionTrackSignal> toks = SignalJunctionTrackRoutes(lay, routes, t, paths, graph, programs, spec);
+						const auto viol = CheckJunctionRules(lay, spec, t);
+						bool bad = false;
+						for (auto &o : OccupancyOf(routes, graph)) {
+							if (base_occ.count({std::get<0>(o), std::get<1>(o), std::get<2>(o)}) != 0) continue;
+							out << head << "OCC\t" << (std::get<0>(o) == 0 ? "share" : "touch") << "\te" << std::get<1>(o) << "-e" << std::get<2>(o) << "\t" << std::get<3>(o) << "," << std::get<4>(o) << "\n";
+						}
+						for (const RuleViolation &v : viol) {
