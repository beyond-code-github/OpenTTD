+
+/* G3P dump hook (temporary, never committed). */
+void G3DumpArm(int calls);
+bool G3DumpTaken();
+const JunctionTrackStructure &G3DumpStructure();
+std::string G3DumpCapture(int axis);
+
+static const std::vector<std::tuple<const char *, const char *, const char *>> G3_TOPOLOGIES = {
+	{"T", "L_R", "L_R"}, {"LLRR_x_LR", "LL_RR", "L_R"}, {"LR_x_LRR", "L_R", "L_RR"}, {"LR_x_LLRR", "L_R", "LL_RR"}, {"LLRR_x_LLRR", "LL_RR", "LL_RR"},
+};
+
+/** The structure the dump uses: the seed's cut when the seed places, else the default cut (the first placement call of the cut search). */
+static JunctionTrackStructure G3Structure(const JunctionTopology &topology, const JunctionGraphSeed &seed)
+{
+	if (!seed.routes.empty()) return seed.structure;
+	std::string error;
+	G3DumpArm(1);
+	MakeJunctionGraphSeed(topology, MakeTestJunctionSpec(), &error);
+	return G3DumpStructure();
+}
+
+TEST_CASE("G3P: dump the placement systems", "[.g3dump]")
+{
+	const char *dir = std::getenv("G3_DIR");
+	REQUIRE(dir != nullptr);
+	for (const auto &[name, main, branch] : G3_TOPOLOGIES) {
+		const JunctionTopology topology = MakeJunctionHubTopology(ParseLineNotation(main).spec, ParseLineNotation(branch).spec, JunctionLanePairing::AnyToAny);
+		const JunctionSpec spec = MakeTestJunctionSpec();
+		std::string seed_error;
+		G3DumpArm(0);
+		const JunctionGraphSeed seed = MakeJunctionGraphSeed(topology, spec, &seed_error);
+		std::string error;
+		std::string choices = "null";
+		std::string size = "null";
+		if (!seed.routes.empty()) {
+			std::string why;
+			const JunctionTrackOrder order = OrderJunctionTrackGraph(topology, seed.paths, seed.graph, &why);
+			G3DumpArm(1);
+			const JunctionTrackPlacement placed = PlaceJunctionTrackGraph(topology, seed.paths, seed.graph, order, seed.structure, seed.programs, spec, &error);
+			CHECK(placed.choices == seed.placement.choices);
+			const JunctionPlacementChoices &c = placed.choices;
+			std::string m, corner;
+			for (size_t e = 0; e < c.m.size(); e++) {
+				for (size_t t = 0; t < c.m[e].size(); t++) {
+					m += fmt::format("{}[{},{},{}]", m.empty() ? "" : ",", e, t, c.m[e][t]);
+					corner += fmt::format("{}[{},{},{}]", corner.empty() ? "" : ",", e, t, c.corner[e][t]);
+				}
+			}
+			choices = fmt::format("{{\"port_offset\":{},\"m\":[{}],\"corner\":[{}]}}", c.port_offset, m, corner);
+			size = fmt::format("[{},{}]", placed.size.x, placed.size.y);
+		} else {
+			G3DumpArm(1);
+			MakeJunctionGraphSeed(topology, spec, &error);
+		}
+		REQUIRE(G3DumpTaken());
+		std::string escaped;
+		for (char ch : error) {
+			if (ch == '"' || ch == '\\') escaped += '\\';
+			escaped += ch;
+		}
+		const std::string x = G3DumpCapture(0), y = G3DumpCapture(1);
+		std::ofstream out(fmt::format("{}/{}.json", dir, name));
+		out << fmt::format("{{\"name\":\"{}\",\"main\":\"{}\",\"branch\":\"{}\",\"seed_places\":{},\"error\":\"{}\",\"choices\":{},\"size\":{},\"X\":{},\"Y\":{}}}\n", name, main, branch, seed.routes.empty() ? "false" : "true", escaped, choices, size, x.empty() ? "null" : x, y.empty() ? "null" : y);
+	}
+}
+
+TEST_CASE("G3P: place with the prototype's choices", "[.g3apply]")
+{
+	const char *dir = std::getenv("G3_DIR");
+	REQUIRE(dir != nullptr);
+	for (const auto &[name, main, branch] : G3_TOPOLOGIES) {
+		std::ifstream in(fmt::format("{}/{}.choices", dir, name));
+		if (!in) continue;
+		const JunctionTopology topology = MakeJunctionHubTopology(ParseLineNotation(main).spec, ParseLineNotation(branch).spec, JunctionLanePairing::AnyToAny);
+		const JunctionSpec spec = MakeTestJunctionSpec();
+		std::string seed_error;
+		G3DumpArm(0);
+		const JunctionGraphSeed seed = MakeJunctionGraphSeed(topology, spec, &seed_error);
+		std::string why;
+		const auto paths = ExpandJunctionLanes(topology, &why);
+		const JunctionTrackGraph graph = BuildJunctionTrackGraph(topology, paths, &why);
+		const JunctionTrackOrder order = OrderJunctionTrackGraph(topology, paths, graph, &why);
+		const JunctionTrackStructure uncut = StructureJunctionTrackGraph(topology, paths, graph, order, &why);
+		const JunctionTrackPrograms programs = ProgramJunctionTrackGraph(topology, paths, graph, order, uncut, &why);
+		const JunctionTrackStructure structure = G3Structure(topology, seed);
+		JunctionPlacementChoices choices;
+		choices.m.resize(graph.edges.size());
+		choices.corner.resize(graph.edges.size());
+		for (size_t e = 0; e < graph.edges.size(); e++) {
+			choices.m[e].assign(programs.edges[e].size(), 0);
+			choices.corner[e].assign(programs.edges[e].size(), 0);
+		}
+		std::string kind;
+		in >> choices.port_offset;
+		while (in >> kind) {
+			size_t e, t;
+			int v;
+			in >> e >> t >> v;
+			(kind == "m" ? choices.m : choices.corner)[e][t] = v;
+		}
+		std::string error;
+		const JunctionTrackPlacement placed = PlaceJunctionTrackGraph(topology, paths, graph, order, structure, programs, spec, choices, &error);
+		std::ofstream out(fmt::format("{}/{}.apply.txt", dir, name));
+		if (placed.nodes.empty()) {
+			out << "fails: " << error << "\n";
+		} else {
+			std::string render_error;
+			std::vector<JunctionTrackRoute> routes;
+			RenderJunctionTrackPlacement(topology, paths, graph, structure, programs, placed, &render_error, &routes);
+			out << "places: box " << placed.size.x << " x " << placed.size.y << "; render " << (routes.empty() ? "fails: " + render_error : std::string("ok")) << "\n";
+		}
+	}
+}
