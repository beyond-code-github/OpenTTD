+/** The hover plan, stage by stage: returns "" when it plans, else the stage and message. */
+std::string N1Plan(const N1Ctx &c, const N1Fixture &f, const JunctionFacts &facts, JunctionTrackPlacement *out_placement = nullptr)
+{
+	std::string error;
+	const JunctionTrackPlacement placement = PlaceJunctionTrackGraph(*c.t, c.seed.paths, c.seed.graph, c.order, c.seed.structure, c.seed.programs, c.spec, c.seed.placement.choices, facts, f.offset, &error, true, true, &f.terrain);
+	if (out_placement != nullptr) *out_placement = placement;
+	if (placement.nodes.empty()) return "placement: " + (error.empty() ? std::string("no placement") : error);
+	std::vector<JunctionTrackRoute> routes;
+	JunctionLayout layout = RenderJunctionTrackPlacement(*c.t, c.seed.paths, c.seed.graph, c.seed.structure, c.seed.programs, placement, &error, &routes);
+	if (layout.tracks.empty()) return "render: " + (error.empty() ? std::string("empty") : error);
+	std::string signal_why;
+	SignalJunctionTrackRoutes(layout, routes, *c.t, c.seed.paths, c.seed.graph, c.seed.programs, c.spec, &signal_why);
+	if (!signal_why.empty()) return "signals: " + signal_why;
+	return "";
+}
+
+std::string N1Str(int v) { std::ostringstream o; o << v; return o.str(); }
+
+std::string N1ChainText(const std::vector<JunctionPlacementReason> &why)
+{
+	std::string s;
+	for (const JunctionPlacementReason &r : why) {
+		s += std::string(s.empty() ? "" : " <- ") + (r.rule != nullptr ? r.rule : "?") + "(";
+		s += r.edge != UINT32_MAX ? "e" + N1Str(r.edge) : "";
+		s += r.node != UINT32_MAX ? "n" + N1Str(r.node) : "";
+		s += r.row >= 0 ? "r" + N1Str(r.row) : "";
+		s += ")";
+	}
+	return s;
+}
+
+N1Ctx N1Setup()
+{
+	N1Ctx c;
+	c.spec = MakeTestJunctionSpec();
+	std::string error;
+	c.t = &JunctionTTopology();
+	c.seed = MakeJunctionGraphSeed(*c.t, c.spec, &error);
+	REQUIRE(!c.seed.routes.empty());
+	c.order = OrderJunctionTrackGraph(*c.t, c.seed.paths, c.seed.graph, &error);
+	c.seed_layout = RenderJunctionTrackPlacement(*c.t, c.seed.paths, c.seed.graph, c.seed.structure, c.seed.programs, c.seed.placement, &error);
+	return c;
+}
