+namespace {
+struct N1Item {
+	uint32_t edge, node;
+	int row;
+	bool operator<(const N1Item &o) const { return std::tie(edge, node, row) < std::tie(o.edge, o.node, o.row); }
+	bool operator==(const N1Item &) const = default;
+};
+std::string N1ItemText(const N1Item &i)
+{
+	std::string s = i.node != UINT32_MAX ? "NODE n" + N1Str(static_cast<int>(i.node)) : "EDGE e" + N1Str(static_cast<int>(i.edge));
+	if (i.node != UINT32_MAX && i.edge != UINT32_MAX) s += " (in e" + N1Str(static_cast<int>(i.edge)) + ")";
+	if (i.row >= 0) s += " r" + N1Str(i.row);
+	return s;
+}
+/** The facts of a chain, in order, distinct. */
+std::vector<N1Item> N1ChainFacts(const std::vector<JunctionPlacementReason> &why)
+{
+	std::vector<N1Item> r;
+	for (const JunctionPlacementReason &x : why) {
+		if (x.rule == nullptr || std::string(x.rule) != "blocked tile") continue;
+		const N1Item item{x.edge, x.node, x.row};
+		if (std::ranges::find(r, item) == r.end()) r.push_back(item);
+	}
+	return r;
+}
+/** Cheapest flat level cost of a tile (JunctionLevels' Evaluate, kind 0 with the foundation option; steep and non-buildable excluded). */
+bool N1NodeCost(const JunctionTerrain &t, int x, int y, Money &best)
+{
+	const JunctionTerrainTile *tile = t.At(x, y);
+	if (tile == nullptr || tile->cls != JunctionTileClass::Buildable) return false;
+	best = INT64_MAX;
+	const std::array<int, 4> current = JunctionTileCorners(*tile);
+	for (int level = tile->z_min - 1; level <= tile->z_max + 1; level++) {
+		Money cost;
+		int steps = 0;
+		for (int i = 0; i < 4; i++) steps += std::abs(level - current[i]);
+		if (steps == 0) { cost = tile->clear_cost; } else {
+			cost = tile->clear_cost + t.terraform_cost * steps;
+			if (!tile->steep && tile->z_min < tile->z_max && tile->z_max == level && t.build_on_slopes) cost = std::min(cost, tile->clear_cost + t.foundation_cost);
+		}
+		best = std::min(best, cost);
+	}
+	return true;
+}
