+namespace {
+/** The waiver iteration of E1b as a function: the failing items in order (first chain fact per round), up to max_rounds; end text. */
+std::vector<N1Item> N1Items(const N1Ctx &c, const N1Fixture &f, const JunctionFacts &facts, int max_rounds, std::string &end, std::vector<std::string> *notes = nullptr)
+{
+	std::vector<N1Item> waived;
+	g_n1_waive.clear();
+	JunctionTrackPlacement pl;
+	std::string r = N1Plan(c, f, facts, &pl);
+	end = r.empty() ? "plans" : "";
+	for (int round = 0; !r.empty(); round++) {
+		const std::vector<N1Item> cf = N1ChainFacts(pl.why);
+		if (cf.empty()) { end = "no fact in chain"; break; }
+		if (round == max_rounds) { end = "still failing"; break; }
+		waived.push_back(cf[0]);
+		g_n1_waive.insert({cf[0].edge, cf[0].node, cf[0].row});
+		r = N1Plan(c, f, facts, &pl);
+		if (r.empty()) { end = "plans"; break; }
+		if (pl.why.empty()) { end = "X solved, later: " + r.substr(0, 60); break; }
+	}
+	g_n1_waive.clear();
+	(void)notes;
+	return waived;
+}
+
+struct N1Piece { TileIndexDiffC tile; Trackdir td; int units; bool bridge; };
+
+/** The curves of a piece list: unit position of each direction change and its hand. */
+void N1Curves(const std::vector<N1Piece> &pieces, std::vector<JunctionCurveHand> &hands, std::vector<int> &pos)
+{
+	int unit = 0;
+	for (size_t i = 0; i < pieces.size(); i++) {
+		if (i > 0) {
+			const Direction a = TrackdirToDirection(pieces[i - 1].td), b = TrackdirToDirection(pieces[i].td);
+			if (a != b) {
+				const int diff = (static_cast<int>(b) - static_cast<int>(a) + 8) % 8;
+				hands.push_back(diff == 1 ? JunctionCurveHand::Right : JunctionCurveHand::Left);
+				pos.push_back(unit);
+			}
+		}
+		unit += pieces[i].units;
+	}
+}
+
+/** The least middle run (axis tiles between the two S-bends of a shift) for which the shift's four curves keep the curve gaps; side 0 is 'L' first. */
+int N1ShiftKMin(const JunctionSpec &spec, int side)
+{
+	for (int k = 1; k < 30; k++) {
+		std::string moves = "FF";
+		moves += side == 0 ? "LFR" : "RFL";
+		moves.append(k, 'F');
+		moves += side == 0 ? "RFL" : "LFR";
+		moves += "FF";
+		const JunctionRaster r = RasterizeJunctionRoute({{0, 0}, Trackdir::X_SW, moves});
+		if (!r.error.empty()) continue;
+		std::vector<N1Piece> pieces;
+		for (const JunctionPiece &p : r.pieces) pieces.push_back({p.tile, p.trackdir, p.units, p.on_bridge});
+		std::vector<JunctionCurveHand> hands;
+		std::vector<int> pos;
+		N1Curves(pieces, hands, pos);
+		if (JunctionCurveGapsHold(JunctionCurveGaps(hands, spec.tl, spec.curve_speed, spec.reference_speed), pos)) return k;
+	}
+	return 30;
+}
+
+bool N1Axis(Trackdir td) { return td == Trackdir::X_SW || td == Trackdir::X_NE || td == Trackdir::Y_NW || td == Trackdir::Y_SE; }
+}
