+/** The first blocked tile named in an error text, or false. */
+bool N1FirstTile(const std::string &text, int &x, int &y)
+{
+	const size_t at = text.find("[blocked tile (");
+	if (at == std::string::npos) return false;
+	std::istringstream in(text.substr(at + 15));
+	char comma = 0;
+	in >> x >> comma >> y;
+	return !in.fail() && comma == ',';
+}
