+namespace {
+std::string N1Plan2(const N1Ctx &c, const N1Fixture &f, const JunctionFacts &facts, const JunctionPlacementChoices &choices, TileIndexDiffC offset, JunctionTrackPlacement *out_placement = nullptr)
+{
+	std::string error;
+	const JunctionTrackPlacement placement = PlaceJunctionTrackGraph(*c.t, c.seed.paths, c.seed.graph, c.order, c.seed.structure, c.seed.programs, c.spec, choices, facts, offset, &error, true, true, &f.terrain);
+	if (out_placement != nullptr) *out_placement = placement;
+	if (placement.nodes.empty()) return "placement: " + (error.empty() ? std::string("no placement") : error);
+	std::vector<JunctionTrackRoute> routes;
+	JunctionLayout layout = RenderJunctionTrackPlacement(*c.t, c.seed.paths, c.seed.graph, c.seed.structure, c.seed.programs, placement, &error, &routes);
+	if (layout.tracks.empty()) return "render: " + (error.empty() ? std::string("empty") : error);
+	std::string signal_why;
+	SignalJunctionTrackRoutes(layout, routes, *c.t, c.seed.paths, c.seed.graph, c.seed.programs, c.spec, &signal_why);
+	if (!signal_why.empty()) return "signals: " + signal_why;
+	return "";
+}
