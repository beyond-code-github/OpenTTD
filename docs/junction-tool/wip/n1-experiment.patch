+			reasons[r.substr(0, r.find(':') + 1 + (r.find("blocked tile") != std::string::npos ? 0 : 0))]++;
+		}
+		const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+		/* The ceiling: every single and pair, uncapped. */
+		int all_solves = 0;
+		bool any_pass = false;
+		std::string any_how;
+		for (const Assign &a : assigns) {
+			JunctionPlacementChoices ch = base;
+			g_n1_xfloors.clear();
+			g_n1_yfloors.clear();
+			for (size_t id : a.ids) {
+				const N1Edit &e = pool[id];
+				if (e.choice) e.choice(ch);
+				for (auto &p : e.xf) g_n1_xfloors.push_back(p);
+				for (auto &p : e.yf) g_n1_yfloors.push_back(p);
+			}
+			all_solves++;
+			if (N1Plan2(c, f, facts, ch, f.offset).empty()) { any_pass = true; for (size_t id : a.ids) any_how += (any_how.empty() ? "" : " + ") + pool[id].name; break; }
+		}
+		g_n1_xfloors.clear();
+		g_n1_yfloors.clear();
+		if (any_pass) ceiling_pass++;
+		out << "  ceiling (all singles and pairs): " << (any_pass ? "passes by " + any_how + " after " + N1Str(all_solves) + " solves" : "none of " + N1Str(all_solves)) << "\n";
+		out << f.name << " items=" << items.size() << " pool=" << pool.size() << " assignments=" << assigns.size() << " solves=" << solves << " " << (ok ? "PLANS by " + how : std::string("no plan")) << " ms=" << ms << "\n";
+		if (ok) { passed++; solves_pass.push_back(solves); }
+		solves_all.push_back(solves);
+		wall_ms.push_back(ms);
+		(void)fail_first; (void)remaining;
+	}
+	out << "failing fixtures " << fixtures_failing << ", planned by negotiation " << passed << " (so " << 19 + passed << " of 48)\n";
+	out << "ceiling (all singles and pairs, uncapped): " << ceiling_pass << "\n";
+	out << "solves for the passing ones:"; for (int v : solves_pass) out << " " << v; out << "\n";
+	out << "pass by first edit kind:"; for (auto &[k, v] : pass_kind) out << " [" << k << "]=" << v; out << "\n";
+	if (!wall_ms.empty()) { std::ranges::sort(wall_ms); out << "wall ms per fixture: mean " << std::accumulate(wall_ms.begin(), wall_ms.end(), 0.0) / wall_ms.size() << " max " << wall_ms.back() << "\n"; }
+}
+
+TEST_CASE("n1 e5 what remains", "[.n1]")
+{
+	N1Ctx c = N1Setup();
+	const std::vector<N1Fixture> fixtures = N1LoadFixtures(c.seed_layout);
+	const std::string dir = "/tmp/claude-1000/-home-pete-OpenTTD/021af430-3972-438e-9e4b-c282ea3899fd/scratchpad/";
+	std::ofstream out(dir + "n1_e5.txt");
+	std::map<std::string, int> groups;
+	int shift_bigger = 0, fail_n = 0, offset_ok = 0, shift_ok = 0, shift_offset_ok = 0, port_blocked = 0;
+	std::vector<int> radii, widths;
+	for (const N1Fixture &f : fixtures) {
+		const JunctionFacts facts(f.terrain);
+		g_n1_xfloors.clear(); g_n1_yfloors.clear(); g_n1_waive.clear();
+		JunctionTrackPlacement pl;
+		std::string r0 = N1Plan2(c, f, facts, c.seed.placement.choices, f.offset, &pl);
+		if (r0.empty()) continue;
+		fail_n++;
+		std::ostringstream line;
+		line << f.name << ":";
+		/* Port tiles blocked at the flat offset. */
+		bool port_hit = false;
+		for (const TileIndexDiffC &p : c.seed.placement.ports) port_hit |= !facts.Buildable(p.x + f.offset.x, p.y + f.offset.y);
+		if (port_hit) { port_blocked++; line << " PORT-TILE-BLOCKED"; }
+		/* The least frame shift (Chebyshev radius) that plans with the seed's choices. */
+		int best_r = -1;
+		for (int radius = 1; radius <= 8 && best_r < 0; radius++) {
+			for (int dy = -std::min(radius, 4); dy <= std::min(radius, 4) && best_r < 0; dy++) {
+				for (int dx = -radius; dx <= radius; dx++) {
+					if (std::max(std::abs(dx), std::abs(dy)) != radius) continue;
+					const TileIndexDiffC o = {static_cast<int16_t>(f.offset.x + dx), static_cast<int16_t>(f.offset.y + dy)};
+					if (N1Plan2(c, f, facts, c.seed.placement.choices, o).empty()) { best_r = radius; break; }
+				}
+			}
+		}
+		if (best_r > 0) { offset_ok++; radii.push_back(best_r); line << " frame-shift-plans r=" << best_r; }
+		/* The obstacles, round by round: the first blocked tile of each waived item, its stretch along the row and its lateral room. */
+		std::string end;
+		JunctionTrackPlacement pl2;
+		std::vector<N1Item> waived;
+		g_n1_waive.clear();
+		std::string r = N1Plan2(c, f, facts, c.seed.placement.choices, f.offset, &pl2);
+		bool all_shiftable = true, any_item = false;
+		for (int round = 0; round < 6 && !r.empty(); round++) {
+			const std::vector<N1Item> cf = N1ChainFacts(pl2.why);
+			if (cf.empty()) break;
+			any_item = true;
+			int x = 0, y = 0;
+			const bool have = N1FirstTile(r, x, y);
+			const N1Item it = cf[0];
+			const bool row_run = it.row >= 0 && it.node == UINT32_MAX; // a run on a row of the lane stack
+			bool shiftable = false;
+			int width = 0;
+			if (have && row_run) {
+				int s = x, e = x;
+				while (!facts.Buildable(s - 1, y) && s > x - 50) s--;
+				while (!facts.Buildable(e + 1, y) && e < x + 50) e++;
+				width = e - s + 1;
+				for (const int side : {1, -1}) {
+					bool ok = facts.Buildable(s - 2, y) && facts.Buildable(e + 2, y);
+					for (int t = s - 1; t <= e + 1; t++) ok = ok && facts.Buildable(t, y + side);
+					shiftable |= ok;
+					/* A shift of m rows: the stair of the S-bend halves, then the run on row y + m * side. */
+					for (int m = 2; m <= 3; m++) {
+						bool okm = facts.Buildable(s - 2, y) && facts.Buildable(e + 2, y);
+						for (int j = 0; j < m && okm; j++) {
+							okm = okm && facts.Buildable(s - 1 + j, y + side * j) && facts.Buildable(s - 1 + j, y + side * (j + 1)) && facts.Buildable(e + 1 - j, y + side * j) && facts.Buildable(e + 1 - j, y + side * (j + 1));
+						}
+						for (int t = s - 1 + (m - 1); t <= e + 1 - (m - 1) && okm; t++) okm = okm && facts.Buildable(t, y + side * m);
+						if (okm && !shiftable) { shift_bigger++; shiftable = true; }
+					}
+				}
+				widths.push_back(width);
+			}
+			line << " [" << N1ItemText(it) << " tile " << (have ? N1Str(x) + "," + N1Str(y) : std::string("?")) << (row_run ? " w=" + N1Str(width) + (shiftable ? " shiftable" : " no-lateral-room") : std::string(" not-a-row-run")) << "]";
+			if (!shiftable) all_shiftable = false;
+			g_n1_waive.insert({it.edge, it.node, it.row});
+			r = N1Plan2(c, f, facts, c.seed.placement.choices, f.offset, &pl2);
+			if (!r.empty() && pl2.why.empty()) break;
+		}
+		g_n1_waive.clear();
+		if (any_item && all_shiftable) { shift_ok++; line << " ALL-SHIFTABLE"; }
+		std::string cls;
+		if (best_r > 0) cls = "frame shift plans it";
+		else if (port_hit) cls = "port tile blocked (frame)";
+		else if (any_item && all_shiftable) cls = "shift candidates (row runs with lateral room)";
+		else cls = "no single edit: bend/node/column obstacle or no lateral room";
+		groups[cls]++;
+		out << line.str() << "\n";
+		(void)shift_offset_ok;
+	}
+	out << "failing " << fail_n << ", plan by a frame shift of the box (radius <= 8 x, <= 4 y; same choices) " << offset_ok << ", port tile blocked at flat offset " << port_blocked << ", every item a shiftable row run " << shift_ok << "\n";
+	out << "items made shiftable only by a shift of 2 or 3 rows: " << shift_bigger << "\n";
+	for (auto &[k, v] : groups) out << "GROUP [" << k << "] " << v << "\n";
+	std::ranges::sort(radii); out << "frame radius:"; for (int v : radii) out << " " << v; out << "\n";
+	std::ranges::sort(widths); out << "row-run obstacle widths:"; for (int v : widths) out << " " << v; out << "\n";
+}
