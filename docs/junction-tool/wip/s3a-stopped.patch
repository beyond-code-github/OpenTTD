+
+/** The error text of the seed of a main x branch topology, empty on success. */
+static std::string SeedErrorOf(const char *main, const char *branch)
+{
+	const JunctionTopology topology = MakeJunctionHubTopology(ParseLineNotation(main).spec, ParseLineNotation(branch).spec, JunctionLanePairing::AnyToAny);
+	std::string error;
+	MakeJunctionGraphSeed(topology, MakeTestJunctionSpec(), &error);
+	return error;
+}
+
+TEST_CASE("placement: a node lies on the item its in edges end on", "[junction][topology]")
+{
+	const std::string error = SeedErrorOf("LL_RR", "LL_RR");
+	INFO(error);
+	CHECK(error.find("stack rows (row 1) <- row nodes") == std::string::npos);
+}
+
+TEST_CASE("placement: an edge leaving a merge meets it by a run", "[junction][topology]")
+{
+	const std::string error = SeedErrorOf("L_R", "LL_RR");
+	INFO(error);
+	CHECK(error.find("curve gap (edge 17) <- S-bend size (edge 9)") == std::string::npos);
+}
+
+TEST_CASE("bridge cut: the reported failure is the default cut's", "[junction][topology]")
+{
+	const std::string error = SeedErrorOf("L_R", "L_RR");
+	INFO(error);
+	CHECK(error.find("bridge heads hug crossers") == std::string::npos);
+}
