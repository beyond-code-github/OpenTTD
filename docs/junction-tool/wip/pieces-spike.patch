+	/** EXPERIMENT: a deletion filter down to a small infeasible set of rows and parities; prints it. */
+	void Shrink(size_t n0)
+	{
+		const size_t nr = this->rows.size(), np = this->parity.size();
+		std::vector<bool> on(nr + np, true);
+		const auto infeasible = [&]() {
+			JunctionMilp m;
+			m.SetTimeLimit(2.0);
+			for (size_t i = 0; i < n0; i++) m.AddVariable(this->lb[i], this->ub[i], 0.0, true);
+			for (size_t k = 0; k < np; k++) m.AddVariable(-INF, INF, 0.0, true);
+			for (size_t r = 0; r < nr; r++) if (on[r]) m.AddRow(this->rows[r].terms, this->rows[r].lower, this->rows[r].upper);
+			for (size_t k = 0; k < np; k++) {
+				if (!on[nr + k]) continue;
+				const std::vector<std::pair<uint32_t, double>> terms{{this->parity[k].first, 1.0}, {static_cast<uint32_t>(n0 + k), -2.0}};
+				m.AddRow(terms, this->parity[k].second, this->parity[k].second);
+			}
+			return m.Solve() == JunctionMilp::Status::Infeasible;
+		};
+		for (size_t chunk = (nr + np) / 2; chunk >= 1; chunk /= 2) {
+			for (size_t s0 = 0; s0 < on.size(); s0 += chunk) {
+				std::vector<size_t> idx;
+				for (size_t i = s0; i < std::min(on.size(), s0 + chunk); i++) if (on[i]) idx.push_back(i);
+				if (idx.empty()) continue;
+				for (size_t i : idx) on[i] = false;
+				if (!infeasible()) for (size_t i : idx) on[i] = true;
+			}
+			if (chunk == 1) break;
+		}
+		for (size_t r = 0; r < nr; r++) {
+			if (!on[r]) continue;
+			std::string t;
+			for (const auto &[v, c] : this->rows[r].terms) t += fmt::format(" {:+}*v{}", c, v);
+			fmt::print(stderr, "IIS row {} [{}] {} in [{}, {}]\n", r, this->row_ctx[r], t, this->rows[r].lower, this->rows[r].upper);
+		}
+		for (size_t k = 0; k < np; k++) if (on[nr + k]) fmt::print(stderr, "IIS parity v{} = {} mod 2 [{}]\n", this->parity[k].first, this->parity[k].second, this->par_ctx[k]);
+	}
